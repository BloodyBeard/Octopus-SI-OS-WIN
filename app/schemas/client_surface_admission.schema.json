{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octopus.local/schemas/client_surface_admission.schema.json",
  "title": "Octopus Client Surface Admission Verdict",
  "type": "object",
  "required": ["passed", "details"],
  "properties": {
    "passed": { "type": "boolean" },
    "details": {
      "type": "object",
      "required": ["verifier", "contract", "source_digest", "issues"],
      "properties": {
        "verifier": { "const": "client_surface_document_v1" },
        "contract": { "const": "octopus.client_surface@1" },
        "document_id": { "type": ["string", "null"] },
        "revision": { "type": ["integer", "null"] },
        "source_digest": { "type": "string", "minLength": 1, "maxLength": 128 },
        "node_count": { "type": "integer", "minimum": 0 },
        "max_depth": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "path", "message"],
            "properties": {
              "code": { "type": "string", "minLength": 1, "maxLength": 96 },
              "path": { "type": "string", "maxLength": 512 },
              "message": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
