{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octopus.local/schemas/client_extension_manifest.schema.json",
  "title": "Octopus Client Extension Manifest",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "id",
    "version",
    "name",
    "description",
    "developer",
    "category",
    "glyph",
    "default_installed",
    "contribution"
  ],
  "properties": {
    "schema": { "const": "octopus.client_extension" },
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$",
      "maxLength": 64
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 96 },
    "description": { "type": "string", "minLength": 1, "maxLength": 320 },
    "developer": { "type": "string", "minLength": 1, "maxLength": 96 },
    "category": { "enum": ["widget", "tab", "repair", "input"] },
    "glyph": { "$ref": "https://octopus.local/schemas/client_surface_document.schema.json#/$defs/glyph" },
    "default_installed": { "type": "boolean" },
    "contribution": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "surface_id"],
          "properties": {
            "kind": { "const": "builtin" },
            "surface_id": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "document"],
          "properties": {
            "kind": { "const": "surface" },
            "document": { "$ref": "https://octopus.local/schemas/client_surface_document.schema.json" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "action_id", "triggers"],
          "properties": {
            "kind": { "const": "builtin_action" },
            "action_id": { "$ref": "#/$defs/id" },
            "triggers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["incident_code", "interface_id"],
                "properties": {
                  "incident_code": { "$ref": "#/$defs/id" },
                  "interface_id": { "$ref": "#/$defs/id" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "input_id", "provider"],
          "properties": {
            "kind": { "const": "builtin_input" },
            "input_id": { "$ref": "#/$defs/id" },
            "provider": {
              "type": "object",
              "required": ["credential_source", "endpoint", "model"],
              "properties": {
                "credential_source": { "$ref": "#/$defs/id" },
                "endpoint": {
                  "type": "string",
                  "pattern": "^https://[a-z0-9.-]+(?::[0-9]{1,5})?/[A-Za-z0-9._~/-]{0,255}$",
                  "maxLength": 320
                },
                "model": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/filesystemSource" },
          { "$ref": "#/$defs/deviceSource" },
          { "$ref": "#/$defs/credentialSource" }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "sourceBase": {
      "type": "object",
      "required": ["id", "label", "description", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 96 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "required": { "type": "boolean" }
      }
    },
    "filesystemSource": {
      "allOf": [
        { "$ref": "#/$defs/sourceBase" },
        {
          "type": "object",
          "required": ["kind", "selection", "read"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 96 },
            "description": { "type": "string", "minLength": 1, "maxLength": 240 },
            "required": { "type": "boolean" },
            "kind": { "const": "filesystem" },
            "selection": { "enum": ["file", "directory"] },
            "read": { "enum": ["text", "json", "directory"] },
            "refresh_interval_ms": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 300000
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "deviceSource": {
      "allOf": [
        { "$ref": "#/$defs/sourceBase" },
        {
          "type": "object",
          "required": ["kind", "device"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 96 },
            "description": { "type": "string", "minLength": 1, "maxLength": 240 },
            "required": { "type": "boolean" },
            "kind": { "const": "device" },
            "device": { "enum": ["camera", "microphone"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "credentialSource": {
      "allOf": [
        { "$ref": "#/$defs/sourceBase" },
        {
          "type": "object",
          "required": ["kind", "origin"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "label": { "type": "string", "minLength": 1, "maxLength": 96 },
            "description": { "type": "string", "minLength": 1, "maxLength": 240 },
            "required": { "type": "boolean" },
            "kind": { "const": "credential" },
            "origin": {
              "type": "string",
              "pattern": "^https://[a-z0-9.-]+(?::[0-9]{1,5})?$",
              "maxLength": 256
            },
            "check_path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9._~/-]{0,255}$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
