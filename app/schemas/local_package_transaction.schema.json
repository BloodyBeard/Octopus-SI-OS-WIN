{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octopus.local/schemas/local_package_transaction.schema.json",
  "title": "Octopus Local Package Transaction",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "operation",
    "operation_id",
    "phase",
    "receipts",
    "moves"
  ],
  "properties": {
    "schema": { "const": "octopus.local_package_transaction" },
    "schema_version": { "enum": [1, 2] },
    "operation": { "enum": ["install", "remove", "repair"] },
    "operation_id": { "$ref": "#/$defs/operationId" },
    "pack_id": { "$ref": "#/$defs/id" },
    "phase": {
      "enum": [
        "prepared",
        "committing",
        "owners_materialized",
        "owners_removed",
        "receipts_written",
        "committed",
        "rolling_back"
      ]
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "https://octopus.local/schemas/local_package_receipt.schema.json" }
    },
    "previous_receipts": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "https://octopus.local/schemas/local_package_receipt.schema.json" }
    },
    "moves": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "registry_kind",
          "owner",
          "target",
          "stage",
          "backup",
          "digest",
          "state"
        ],
        "properties": {
          "package_id": { "$ref": "#/$defs/id" },
          "registry_kind": { "type": "string", "minLength": 1, "maxLength": 64 },
          "owner": { "$ref": "#/$defs/id" },
          "target": { "$ref": "#/$defs/relativePath" },
          "stage": { "$ref": "#/$defs/relativePath" },
          "backup": { "$ref": "#/$defs/relativePath" },
          "digest": { "$ref": "#/$defs/digest" },
          "previous_digest": { "$ref": "#/$defs/digest" },
          "state": { "enum": ["planned", "staged", "materialized", "backed_up"] }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 1 } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "operation": { "enum": ["install", "remove"] },
          "moves": { "minItems": 1 }
        },
        "not": { "required": ["previous_receipts"] }
      }
    },
    {
      "if": { "properties": { "schema_version": { "const": 2 } }, "required": ["schema_version"] },
      "then": {
        "required": ["previous_receipts"],
        "properties": {
          "operation": { "const": "repair" },
          "moves": { "items": { "required": ["previous_digest"] } }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "operationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,96}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+/(?:[A-Za-z0-9][A-Za-z0-9._-]{0,127}|\\.[A-Za-z0-9._-]{3,320})$"
    }
  }
}
