{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octopus.local/schemas/client_setup_operation.schema.json",
  "title": "Octopus Client Setup Operation",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "operation_id",
    "plan_digest",
    "plan",
    "steps",
    "updated_at"
  ],
  "properties": {
    "schema": { "const": "octopus.client_setup_operation" },
    "schema_version": { "const": 1 },
    "operation_id": { "$ref": "#/$defs/operationId" },
    "plan_digest": { "$ref": "#/$defs/digest" },
    "plan": { "$ref": "#/$defs/plan" },
    "steps": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/step" }
    },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "last_error": { "$ref": "#/$defs/lastError" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
    "extensionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "operationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,96}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revisionDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "minLength": 20, "maxLength": 40 },
    "plan": {
      "type": "object",
      "required": ["pack", "packages", "extensions", "provider", "workspace"],
      "properties": {
        "pack": {
          "type": "object",
          "required": ["id", "manifest_digest", "selected_recommended"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "manifest_digest": { "$ref": "#/$defs/digest" },
            "selected_recommended": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          },
          "additionalProperties": false
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "required": ["id", "source_digest", "desired_state"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "source_digest": { "$ref": "#/$defs/digest" },
              "desired_state": { "const": "installed" }
            },
            "additionalProperties": false
          }
        },
        "extensions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["id", "version", "source_digest", "desired_state"],
            "properties": {
              "id": { "$ref": "#/$defs/extensionId" },
              "version": { "type": "string", "minLength": 1, "maxLength": 256 },
              "source_digest": { "$ref": "#/$defs/revisionDigest" },
              "desired_state": { "enum": ["installed", "available"] }
            },
            "additionalProperties": false
          }
        },
        "provider": {
          "type": "object",
          "required": ["interface_id", "required_state"],
          "properties": {
            "interface_id": { "$ref": "#/$defs/id" },
              "required_state": { "const": "account_readable" }
          },
          "additionalProperties": false
        },
        "workspace": {
          "type": "object",
          "required": ["request_digest", "request", "project_defaults"],
          "properties": {
            "request_digest": { "$ref": "#/$defs/digest" },
            "request": { "type": "object" },
            "project_defaults": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "required": ["package_id", "product_kind", "product_id", "default_for_new_tasks", "project_keys"],
                "properties": {
                  "package_id": { "$ref": "#/$defs/id" },
                  "product_kind": { "enum": ["application", "driver"] },
                  "product_id": { "$ref": "#/$defs/id" },
                  "default_for_new_tasks": { "type": "boolean" },
                  "project_keys": {
                    "type": "array",
                    "maxItems": 128,
                    "uniqueItems": true,
                    "items": { "$ref": "#/$defs/id" }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "proofReference": {
      "type": "object",
      "required": ["kind", "id", "digest", "evidence"],
      "properties": {
        "kind": {
          "enum": [
            "package_install_evidence",
            "extension_lifecycle_receipt",
            "provider_observation",
            "workspace_receipt"
          ]
        },
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" },
        "evidence": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "required": ["step", "observed_at", "evidence_digest", "references"],
      "properties": {
        "step": { "enum": ["packages", "extensions", "provider", "workspace"] },
        "observed_at": { "$ref": "#/$defs/timestamp" },
        "evidence_digest": { "$ref": "#/$defs/digest" },
        "references": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/proofReference" }
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["step", "state"],
      "properties": {
        "step": { "enum": ["packages", "extensions", "provider", "workspace"] },
        "state": { "enum": ["pending", "complete"] },
        "proof": { "$ref": "#/$defs/proof" }
      },
      "additionalProperties": false
    },
    "lastError": {
      "type": "object",
      "required": ["step", "message", "observed_at"],
      "properties": {
        "step": { "enum": ["packages", "extensions", "provider", "workspace"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "observed_at": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    }
  }
}
