{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octopus.local/schemas/client_extension_publication.schema.json",
  "title": "Octopus Client Extension Publication",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "layout",
    "extension_id",
    "extension_version",
    "manifest_path",
    "source_digest",
    "license",
    "files",
    "bundle_digest"
  ],
  "properties": {
    "schema": { "const": "octopus.client_extension_publication" },
    "schema_version": { "const": 1 },
    "layout": { "const": "octopus.client_extension_library.v1" },
    "extension_id": { "$ref": "#/$defs/id" },
    "extension_version": { "$ref": "#/$defs/version" },
    "manifest_path": { "$ref": "#/$defs/path" },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "license": { "$ref": "#/$defs/license" },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/file" }
    },
    "bundle_digest": { "$ref": "#/$defs/digest" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$",
      "maxLength": 64
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "file": {
      "type": "object",
      "required": ["path", "size", "mode", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "size": { "type": "integer", "minimum": 0 },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["spdx", "path", "sha256"],
      "properties": {
        "spdx": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"
        },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
