{
  "schema": "octopus.local_package",
  "schema_version": 1,
  "id": "world_provider_minimax",
  "version": "1.0.0",
  "product_kind": "application",
  "product_id": "world_provider_minimax",
  "release_status": "optional",
  "display": {
    "name": "MiniMax",
    "description": "MiniMax models through an international MiniMax key.",
    "developer": "MiniMax",
    "category": "provider",
    "icon": "sparkles"
  },
  "members": [
    {
      "registry_kind": "interface",
      "owner": "world_provider_minimax",
      "primary": true,
      "configuration": [
        {
          "path": "interface.json",
          "fields": [
            {
              "pointer": "/interface_driver_config/private_config/model",
              "schema": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "pointer": "/interface_driver_config/private_config/reasoning_effort",
              "schema": {
                "type": "string",
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "required_packages": [
    "world_provider_codex"
  ]
}
