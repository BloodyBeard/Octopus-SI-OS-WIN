(version 1)
(deny default)
(import "dyld-support.sb")
(allow process-exec file-read-data file-map-executable (literal (param "HELPER")))
(allow file-read* file-map-executable (subpath "/System/Library") (subpath "/usr/lib"))
(allow file-read-metadata file-test-existence)
(allow file-read-data
  (require-all
    (vnode-type DIRECTORY)
    (require-any
      (regex #"/[^/]+\.[aA][pP][pP](/[cC][oO][nN][tT][eE][nN][tT][sS]|/[sS][uU][pP][pP][oO][rR][tT] [fF][iI][lL][eE][sS]|/[rR][eE][sS][oO][uU][rR][cC][eE][sS])?$")
      (regex #"/[^/]+\.[aA][pP][pP]/([cC][oO][nN][tT][eE][nN][tT][sS]|[sS][uU][pP][pP][oO][rR][tT] [fF][iI][lL][eE][sS])/[rR][eE][sS][oO][uU][rR][cC][eE][sS]$")
      (regex #"/[^/]+\.[aA][pP][pP]((/[cC][oO][nN][tT][eE][nN][tT][sS]|/[sS][uU][pP][pP][oO][rR][tT] [fF][iI][lL][eE][sS])?/[rR][eE][sS][oO][uU][rR][cC][eE][sS])?/[^/]+\.[lL][pP][rR][oO][jJ]$"))))
(allow file-read-data
  (require-all
    (vnode-type REGULAR-FILE)
    (require-any
      (regex #"/[^/]+\.[aA][pP][pP]/([cC][oO][nN][tT][eE][nN][tT][sS]/|[sS][uU][pP][pP][oO][rR][tT] [fF][iI][lL][eE][sS]/|[rR][eE][sS][oO][uU][rR][cC][eE][sS]/)?[iI][nN][fF][oO](-[mM][aA][cC][oO][sS])?\.[pP][lL][iI][sS][tT]$")
      (regex #"/[^/]+\.[aA][pP][pP]/(([cC][oO][nN][tT][eE][nN][tT][sS]/|[sS][uU][pP][pP][oO][rR][tT] [fF][iI][lL][eE][sS]/)?[rR][eE][sS][oO][uU][rR][cC][eE][sS]/)?([^/]+\.[lL][pP][rR][oO][jJ]/)?[iI][nN][fF][oO][pP][lL][iI][sS][tT](-[mM][aA][cC][oO][sS])?\.[sS][tT][rR][iI][nN][gG][sS]$"))))
(allow file-test-existence (subpath (param "CANCEL_ROOT")))
(allow file-read* file-write* (literal "/dev/null") (subpath "/dev/fd"))
(allow process-info-listpids process-info-pidinfo)
(allow lsopen)
(allow sysctl-read)
(allow sysctl-write (sysctl-name "kern.grade_cputype"))
(allow mach-lookup
  (global-name "com.apple.metadata.mds")
  (global-name "com.apple.pasteboard.1")
  (local-name "com.apple.CFPasteboardClient")
  (global-name "com.apple.coreservices.appleevents")
  (global-name "com.apple.windowserver.active")
  (global-name "com.apple.tccd")
  (global-name "com.apple.tccd.system")
  (global-name "com.apple.replayd")
  (global-name "com.apple.iohideventsystem")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.CoreServices.coreservicesd")
  (global-name "com.apple.lsd.mapdb")
  (global-name "com.apple.cfprefsd.agent")
  (global-name "com.apple.cfprefsd.daemon")
  (global-name "com.apple.CARenderServer")
  (global-name "com.apple.CoreDisplay.master")
  (global-name "com.apple.CoreDisplay.Notification")
  (global-name "com.apple.cvmsServ"))
(allow file-read* (subpath "/private/var/db/CVMS"))
(allow iokit-open-user-client
  (iokit-user-client-class "IOHIDParamUserClient")
  (iokit-user-client-class "IOSurfaceRootUserClient")
  (iokit-user-client-class "IOSurfaceAcceleratorClient")
  (iokit-user-client-class "AGXDeviceUserClient"))
