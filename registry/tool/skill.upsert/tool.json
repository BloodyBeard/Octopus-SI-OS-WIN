{
  "id": "skill.upsert",
  "interface": "system_context",
  "process": {
    "bin": "target/debug/octopus-artifact-bound-tool",
    "authority": {
      "read_root_slots": ["run_records_root"], "write_root_slots": ["artifact_blobs_root"], "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [],
      "executable_commands": [], "read_env_paths": [], "write_env_paths": [],
      "executable_env_paths": [], "allow_network": false, "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": ["system_room"],
  "handler_config": { "operation": "skill_upsert" },
  "description": "Write one immutable skill.recipe artifact. source_run_id, source_trace_id, and source_worker come from the exact active run record; references and supersedes must already be bound to this run. Updating a recipe creates a new content-addressed artifact rather than mutating prior evidence.",
  "args_schema": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 256 },
      "description": { "type": "string", "maxLength": 2048 },
      "body_markdown": { "type": "string", "minLength": 1, "maxLength": 524288 },
      "tags": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "target_worker_types": {
        "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "interfaces": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "references": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "supersedes": { "type": "string", "minLength": 1, "maxLength": 512 },
      "origin": { "type": "string", "minLength": 1, "maxLength": 64 },
      "config_schema": { "type": "object" },
      "env_reqs": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "repeatability": { "type": "string", "minLength": 1, "maxLength": 64 },
      "confidence": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "required": ["name", "body_markdown", "tags", "target_worker_types", "origin"],
    "additionalProperties": false
  },
  "is_world_effect": false
}
