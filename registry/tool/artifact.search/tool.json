{
  "id": "artifact.search",
  "interface": "system_context",
  "process": {
    "bin": "target/debug/octopus-artifact-bound-tool",
    "authority": {
      "read_root_slots": [], "write_root_slots": [], "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [],
      "executable_commands": [], "read_env_paths": [], "write_env_paths": [],
      "executable_env_paths": [], "allow_network": false, "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": ["system_room"],
  "handler_config": { "operation": "search" },
  "description": "Search text surfaces of artifacts currently bound to this run. Results never include artifacts outside the run binding.",
  "args_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Text query to search for."
      },
      "label": {
        "type": "string",
        "description": "Optional exact artifact id label filter."
      },
      "max_results": {
        "type": "integer",
        "minimum": 1,
        "description": "Maximum matching lines to return."
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false
  },
  "is_world_effect": false
}
