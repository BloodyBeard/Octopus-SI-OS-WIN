{
  "id": "browser.wait_complete",
  "interface": "system_browser",
  "handler_config": {
    "operation": "wait_complete"
  },
  "process": {
    "bin": "target/debug/octopus-browser-wait-completion-tool",
    "private_read_subpaths": [
      {
        "path": "secrets/browser-native-host.auth"
      }
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": false,
      "allow_local_ipc": true
    }
  },
  "supported_worker_environment_kinds": [
    "browser_session"
  ],
  "description": "Observe completion of exactly one native browser waiter created by browser.wait phase=start in this same formed room. This genuine completion-observer process waits independently from the page executor. It does not create a page, select or navigate a tab, restart a wait, renew a deadline, replay an action, or cancel another call. The exact retained waiter and original start evidence remain required.",
  "args_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "waiter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "wait_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "host_generation": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "worker_environment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "formation_pin": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "browser_context_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "debugger_epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "start_source_movement_seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "start_artifact_content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "condition_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "wait_id",
          "host_generation",
          "worker_environment_id",
          "formation_pin",
          "browser_context_id",
          "target_id",
          "debugger_epoch",
          "start_source_movement_seq",
          "start_artifact_content_hash",
          "condition_digest"
        ]
      }
    },
    "required": [
      "waiter"
    ]
  },
  "is_world_effect": true
}
