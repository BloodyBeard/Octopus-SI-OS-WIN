{
  "id": "remote.file_write",
  "interface": "system_remote_exec",
  "process": {
    "bin": "target/debug/octopus-remote-exec-room-tool",
    "private_read_subpaths": [{"path": "secrets/remote-exec.auth"}],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": true,
      "allow_local_ipc": false
    }
  },
  "handler_config": { "operation": "file_write" },
  "supported_worker_environment_kinds": [
    "remote_exec_server"
  ],
  "description": "Write a bounded text file inside the formed remote workspace, optionally creating parent directories.",
  "args_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "content": {
        "type": "string",
        "maxLength": 8388608
      },
      "content_base64": {
        "type": "string",
        "maxLength": 11184812
      },
      "create_parents": {
        "type": "boolean"
      }
    },
    "required": [
      "path"
    ],
    "oneOf": [
      {
        "required": [
          "content"
        ]
      },
      {
        "required": [
          "content_base64"
        ]
      }
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
