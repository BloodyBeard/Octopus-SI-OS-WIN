{
  "id": "coder.process.terminate",
  "interface": "system_coder_env",
  "handler_config": {
    "operation": "process_terminate",
    "default_yield_time_ms": 1000,
    "max_yield_time_ms": 30000,
    "default_max_output_bytes": 65536,
    "max_output_bytes": 1048576
  },
  "process": {
    "bin": "target/debug/octopus-coder-exec-tool",
    "inherit_env": ["HOME", "PATH"],
    "authority": {
      "read_root_slots": ["registry_worker_environment_kind_root", "repo_root"],
      "write_root_slots": ["git_common_root", "worktree_root"],
      "executable_root_slots": ["worktree_root"],
      "optional_read_root_slots": ["platform_toolchain_root", "tool_cache_root", "toolchain_root"],
      "optional_write_root_slots": ["platform_toolchain_root"],
      "optional_executable_root_slots": ["platform_toolchain_root", "tool_cache_root", "toolchain_root"],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": ["git", "sh", "bash", "zsh"],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": ["PATH"],
      "allow_network": true,
      "allow_local_ipc": true,
      "allow_sandbox_delegation": true
    }
  },
  "supported_worker_environment_kinds": ["git_worktree"],
  "description": "Terminate one running opaque process owned by this formed Git worktree room and return ordered closure evidence; an already-finished process fails explicitly.",
  "args_schema": {
    "type": "object",
    "properties": {
      "process_id": {"type": "string", "minLength": 1},
      "yield_time_ms": {"type": "integer", "minimum": 0, "maximum": 30000},
      "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
    },
    "required": ["process_id"],
    "additionalProperties": false
  },
  "is_world_effect": false
}
