{
  "id": "container.attach",
  "interface": "system_container",
  "process": {
    "bin": "target/debug/octopus-container-room-tool",
    "inherit_env": [
      "PATH"
    ],
    "inherit_env_from_interface": [
      "/interface_driver_config/private_config/process_env_keys"
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_paths": [],
      "write_paths": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [
        "PATH"
      ],
      "allow_network": true,
      "allow_local_ipc": true,
      "optional_read_env_paths": [
        "DOCKER_CERT_PATH",
        "DOCKER_CONFIG",
        "REGISTRY_AUTH_FILE",
        "XDG_RUNTIME_DIR"
      ]
    }
  },
  "handler_config": { "operation": "attach" },
  "supported_worker_environment_kinds": [
    "container_session"
  ],
  "description": "Attach to the one container attested for this formed worker environment, optionally restarting a stopped instance or recreating an explicitly missing instance.",
  "args_schema": {
    "type": "object",
    "properties": {
      "start_if_stopped": {
        "type": "boolean"
      },
      "recover_if_missing": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "is_world_effect": true
}
