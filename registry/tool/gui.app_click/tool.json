{
  "id": "gui.app_click",
  "interface": "system_gui",
  "handler_config": {
    "operation": "app_click"
  },
  "process": {
    "bin": "target/debug/octopus-gui-session-tool",
    "private_read_subpaths": [
      {
        "path": "desktop-host/connection.json"
      }
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": true,
      "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": [
    "desktop_session"
  ],
  "description": "Click one exact observed application element OR an original screenshot pixel point. Element references preserve native AX action, clipping and scroll-to-visible behavior; they are not guessed screen coordinates. A single left click on a native menu-bar item with its retained menu child selects that logical menu observation context; menu_effects records the transition without claiming AX/input dispatch or a visible OS menu. A null window is valid only for an observed windowless element with a native click action or retained menu plan. Requires the exact approved app, unconsumed observation and current model control. Observe again after an attempted action, including scroll preparation.",
  "args_schema": {
    "type": "object",
    "properties": {
      "grant_request_id": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "app": {
        "type": "object",
        "properties": {
          "host_generation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "app_instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "host_generation",
          "app_instance_id"
        ],
        "additionalProperties": false
      },
      "observation_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "control_generation": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "window_id": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 2048
      },
      "image_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "x": {
        "type": "number",
        "minimum": 0
      },
      "y": {
        "type": "number",
        "minimum": 0
      },
      "button": {
        "type": "string",
        "enum": [
          "left",
          "right",
          "middle"
        ]
      },
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "element_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required": [
      "grant_request_id",
      "app",
      "observation_id",
      "revision",
      "control_generation",
      "window_id",
      "button",
      "count"
    ],
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "element_id"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "image_id"
              ]
            },
            {
              "required": [
                "x"
              ]
            },
            {
              "required": [
                "y"
              ]
            }
          ]
        }
      },
      {
        "required": [
          "image_id",
          "x",
          "y"
        ],
        "not": {
          "required": [
            "element_id"
          ]
        },
        "properties": {
          "window_id": {
            "type": "string"
          }
        }
      }
    ]
  },
  "is_world_effect": true
}
