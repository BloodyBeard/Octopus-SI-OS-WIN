{
  "id": "remote.process_write",
  "interface": "system_remote_exec",
  "process": {
    "bin": "target/debug/octopus-remote-exec-room-tool",
    "private_read_subpaths": [{"path": "secrets/remote-exec.auth"}],
    "authority": {
      "read_root_slots": [], "write_root_slots": [], "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [], "executable_commands": [],
      "read_env_paths": [], "write_env_paths": [], "executable_env_paths": [],
      "allow_network": true, "allow_local_ipc": false
    }
  },
  "handler_config": { "operation": "process_write" },
  "supported_worker_environment_kinds": ["remote_exec_server"],
  "description": "Write bounded UTF-8 or base64-decoded bytes to a named remote process stdin.",
  "args_schema": {
    "type": "object",
    "properties": {
      "process_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
      "data": {"type": "string", "maxLength": 8388608},
      "data_base64": {"type": "string", "maxLength": 11184812}
    },
    "required": ["process_id"],
    "oneOf": [{"required": ["data"]}, {"required": ["data_base64"]}],
    "additionalProperties": false
  },
  "is_world_effect": true
}
