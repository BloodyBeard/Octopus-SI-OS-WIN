{
  "id": "skill.capture",
  "interface": "system_context",
  "process": {
    "bin": "target/debug/octopus-artifact-bound-tool",
    "authority": {
      "read_root_slots": ["run_records_root"], "write_root_slots": ["artifact_blobs_root"], "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [],
      "executable_commands": [], "read_env_paths": [], "write_env_paths": [],
      "executable_env_paths": [], "allow_network": false, "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": ["system_room"],
  "handler_config": { "operation": "skill_capture" },
  "description": "Emit an immutable skill.capture proposal artifact from this run. source_run_id, source_trace_id, and source_worker are derived from the exact active run record and cannot be supplied by the model; later acceptance is ordinary artifact transfer/checkpoint work.",
  "args_schema": {
    "type": "object",
    "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 256 },
      "description": { "type": "string", "maxLength": 2048 },
      "body_markdown": { "type": "string", "minLength": 1, "maxLength": 524288 },
      "tags": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "target_worker_types": {
        "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "interfaces": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "references": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "config_schema": { "type": "object" },
      "env_reqs": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "task_context": { "type": "string", "minLength": 1, "maxLength": 65536 },
      "decision_rationale": { "type": "string", "minLength": 1, "maxLength": 65536 }
    },
    "required": ["name", "body_markdown", "tags", "target_worker_types", "task_context", "decision_rationale"],
    "additionalProperties": false
  },
  "is_world_effect": false
}
