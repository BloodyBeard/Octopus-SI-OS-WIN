{
  "id": "gui.app_key",
  "interface": "system_gui",
  "handler_config": {
    "operation": "app_key"
  },
  "process": {
    "bin": "target/debug/octopus-gui-session-tool",
    "private_read_subpaths": [
      {
        "path": "desktop-host/connection.json"
      }
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": true,
      "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": [
    "desktop_session"
  ],
  "description": "Send either a named physical key chord (for example cmd+shift+p, with unique cmd/ctrl/alt/shift/fn modifiers), or a macOS virtual key code and explicit modifier array. These variants are mutually exclusive. Named keys use the existing declared macOS key parser and unsupported names fail before input dispatch. Send the key to the exact approved application. Requires current model control and an unconsumed gui.app_state observation from the same formed room. Observe again after any attempted action; global display references are not accepted. Set window_id to null for app-level keyboard focus, or provide the exact observed window. The native target is resolved from the retained application focus, including its hosted controls.",
  "args_schema": {
    "type": "object",
    "properties": {
      "grant_request_id": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "app": {
        "type": "object",
        "properties": {
          "host_generation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "app_instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "host_generation",
          "app_instance_id"
        ],
        "additionalProperties": false
      },
      "observation_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "control_generation": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "window_id": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 2048
      },
      "key_code": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      },
      "modifiers": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "command",
            "control",
            "option",
            "shift"
          ]
        },
        "maxItems": 4,
        "uniqueItems": true
      },
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "required": [
      "grant_request_id",
      "app",
      "observation_id",
      "revision",
      "control_generation",
      "window_id"
    ],
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "key"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "key_code"
              ]
            },
            {
              "required": [
                "modifiers"
              ]
            }
          ]
        }
      },
      {
        "required": [
          "key_code",
          "modifiers"
        ],
        "not": {
          "required": [
            "key"
          ]
        }
      }
    ]
  },
  "is_world_effect": true
}
