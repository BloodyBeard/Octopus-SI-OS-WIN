{
  "id": "coder.apply_patch",
  "interface": "system_coder_env",
  "handler_config": {
    "operation": "apply_patch"
  },
  "process": {
    "bin": "target/debug/octopus-coder-fs-tool",
    "inherit_env": ["PATH"],
    "authority": {
      "read_root_slots": ["registry_worker_environment_kind_root", "repo_root"],
      "write_root_slots": ["git_common_root", "worktree_root"],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": ["git"],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": false,
      "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": [
    "git_worktree"
  ],
  "description": "Apply a *** Begin Patch edit inside the invoking run's leased worktree. Success and partial-failure evidence report exact changed paths plus before/after content identities.",
  "args_schema": {
    "type": "object",
    "properties": {
      "patch": {
        "type": "string",
        "description": "A *** Begin Patch edit with Add File / Update File / Delete File sections."
      }
    },
    "required": [
      "patch"
    ],
    "additionalProperties": false
  },
  "is_world_effect": false
}
