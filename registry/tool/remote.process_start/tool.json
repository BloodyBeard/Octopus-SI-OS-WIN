{
  "id": "remote.process_start",
  "interface": "system_remote_exec",
  "process": {
    "bin": "target/debug/octopus-remote-exec-room-tool",
    "private_read_subpaths": [{"path": "secrets/remote-exec.auth"}],
    "authority": {
      "read_root_slots": [], "write_root_slots": [], "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [], "executable_commands": [],
      "read_env_paths": [], "write_env_paths": [], "executable_env_paths": [],
      "allow_network": true, "allow_local_ipc": false
    }
  },
  "handler_config": { "operation": "process_start" },
  "supported_worker_environment_kinds": ["remote_exec_server"],
  "description": "Start one named persistent process inside the formed remote workspace.",
  "args_schema": {
    "type": "object",
    "properties": {
      "process_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
      "argv": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 65536}, "minItems": 1, "maxItems": 256},
      "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
      "env": {"type": "object", "maxProperties": 256, "additionalProperties": {"type": "string", "maxLength": 65536}},
      "tty": {"type": "boolean"},
      "pipe_stdin": {"type": "boolean"}
    },
    "required": ["process_id", "argv"],
    "additionalProperties": false
  },
  "is_world_effect": true
}
