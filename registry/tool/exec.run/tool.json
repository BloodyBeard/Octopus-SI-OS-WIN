{
  "id": "exec.run",
  "interface": "system_exec_env",
  "handler_config": {
    "operation": "run"
  },
  "process": {
    "bin": "target/debug/octopus-process-room-tool",
    "inherit_env": [
      "PATH"
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": ["PATH"],
      "allow_network": false,
      "allow_local_ipc": true
    },
    "coordinate_root_slots": []
  },
  "supported_worker_environment_kinds": [
    "process_session"
  ],
  "description": "Run one bounded command in the private workspace of this formed process-session worker environment.",
  "args_schema": {
    "type": "object",
    "properties": {
      "command": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        ]
      },
      "env": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "max_output_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16777216
      }
    },
    "required": [
      "command"
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
