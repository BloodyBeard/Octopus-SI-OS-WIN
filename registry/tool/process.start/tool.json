{
  "id": "process.start",
  "interface": "system_exec_env",
  "handler_config": {
    "operation": "start"
  },
  "process": {
    "bin": "target/debug/octopus-process-room-tool",
    "inherit_env": [
      "PATH"
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [
        "PATH"
      ],
      "allow_network": false,
      "allow_local_ipc": true
    },
    "coordinate_root_slots": []
  },
  "supported_worker_environment_kinds": [
    "process_session"
  ],
  "description": "Start the persistent process owned by this formed worker environment, optionally as a PTY-backed login shell.",
  "args_schema": {
    "type": "object",
    "properties": {
      "command": {
        "type": "string",
        "minLength": 1
      },
      "argv": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "tty": {
        "type": "boolean"
      },
      "env": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "not": {
      "required": [
        "command",
        "argv"
      ]
    },
    "additionalProperties": false
  },
  "is_world_effect": true
}
