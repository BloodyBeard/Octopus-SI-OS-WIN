{
  "id": "skill.list",
  "interface": "system_context",
  "process": {
    "bin": "target/debug/octopus-artifact-bound-tool",
    "authority": {
      "read_root_slots": [], "write_root_slots": [], "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [],
      "executable_commands": [], "read_env_paths": [], "write_env_paths": [],
      "executable_env_paths": [], "allow_network": false, "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": ["system_room"],
  "handler_config": { "operation": "skill_list" },
  "description": "List one bounded page of skill.recipe artifacts already visible through this run's artifact bindings. Pass next_cursor back unchanged to continue; a changed bound skill set invalidates the cursor explicitly.",
  "args_schema": {
    "type": "object",
    "properties": {
      "cursor": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "limit": { "type": "integer", "minimum": 1, "maximum": 20 }
    },
    "additionalProperties": false
  },
  "is_world_effect": false
}
