{
  "id": "exec.file_write",
  "interface": "system_exec_env",
  "handler_config": {
    "operation": "file_write"
  },
  "process": {
    "bin": "target/debug/octopus-process-room-tool",
    "inherit_env": [
      "PATH"
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [
        "PATH"
      ],
      "allow_network": false,
      "allow_local_ipc": true
    },
    "coordinate_root_slots": []
  },
  "supported_worker_environment_kinds": [
    "process_session"
  ],
  "description": "Write bounded text or base64 bytes to a regular file in the private workspace of this formed process-session worker environment.",
  "args_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "content": {
        "type": "string",
        "maxLength": 16777216
      },
      "content_base64": {
        "type": "string",
        "maxLength": 22369624
      },
      "create_parents": {
        "type": "boolean"
      }
    },
    "required": [
      "path"
    ],
    "oneOf": [
      {
        "required": [
          "content"
        ]
      },
      {
        "required": [
          "content_base64"
        ]
      }
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
