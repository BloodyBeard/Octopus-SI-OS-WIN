{
  "id": "gui.app_set_value",
  "interface": "system_gui",
  "handler_config": {
    "operation": "app_set_value"
  },
  "process": {
    "bin": "target/debug/octopus-gui-session-tool",
    "private_read_subpaths": [
      {
        "path": "desktop-host/connection.json"
      }
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": true,
      "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": [
    "desktop_session"
  ],
  "description": "Set an exact retained Accessibility element value using its advertised value_input conversion: text, en_US decimal number, native Boolean, or localized date components. The tool takes replacement text; native field preparation precedes the typed AX write and readback. Follow the observed format for dates. Boolean text uses on/off or native NSString.boolValue conversion. Requires current model control and an unconsumed gui.app_state observation. Observe again after any attempted action. Use window_id:null only for an observed ax_window_attribute_unavailable element; no global display or inferred window target.",
  "args_schema": {
    "type": "object",
    "properties": {
      "grant_request_id": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "app": {
        "type": "object",
        "properties": {
          "host_generation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "app_instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "host_generation",
          "app_instance_id"
        ],
        "additionalProperties": false
      },
      "observation_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "control_generation": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "window_id": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 2048
      },
      "element_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "value": {
        "type": "string",
        "maxLength": 65536,
        "description": "Replacement text converted according to the exact observed value_input. Date formatting and editable components come from the native element; uneditable date components are retained. Unsupported native value types and unparseable numbers/dates fail before field preparation."
      }
    },
    "required": [
      "grant_request_id",
      "app",
      "observation_id",
      "revision",
      "control_generation",
      "window_id",
      "element_id",
      "value"
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
