{
  "id": "gui.app_resume",
  "interface": "system_gui",
  "handler_config": {
    "operation": "app_resume"
  },
  "process": {
    "bin": "target/debug/octopus-gui-session-tool",
    "private_read_subpaths": [
      {
        "path": "desktop-host/connection.json"
      }
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": true,
      "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": [
    "desktop_session"
  ],
  "description": "Private GUI door continuation for an exact verifier-admitted operator response. Ordinary model tool.call artifacts are refused; this descriptor is not a model-facing approval capability.",
  "args_schema": {
    "type": "object",
    "properties": {
      "request_id": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "required": [
      "request_id"
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
