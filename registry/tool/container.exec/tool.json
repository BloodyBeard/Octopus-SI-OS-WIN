{
  "id": "container.exec",
  "interface": "system_container",
  "process": {
    "bin": "target/debug/octopus-container-room-tool",
    "inherit_env": [
      "PATH"
    ],
    "inherit_env_from_interface": [
      "/interface_driver_config/private_config/process_env_keys"
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_paths": [],
      "write_paths": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [
        "PATH"
      ],
      "allow_network": true,
      "allow_local_ipc": true,
      "optional_read_env_paths": [
        "DOCKER_CERT_PATH",
        "DOCKER_CONFIG",
        "REGISTRY_AUTH_FILE",
        "XDG_RUNTIME_DIR"
      ]
    }
  },
  "handler_config": { "operation": "exec" },
  "supported_worker_environment_kinds": [
    "container_session"
  ],
  "description": "Execute one argv vector inside the running formed container with bounded binary-safe stdout, stderr, stdin, environment, cwd, and timeout evidence.",
  "args_schema": {
    "type": "object",
    "properties": {
      "argv": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "minItems": 1,
        "maxItems": 256
      },
      "cwd": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "env": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "stdin_text": {
        "type": "string",
        "maxLength": 16777216
      },
      "stdin_base64": {
        "type": "string",
        "maxLength": 22369624
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "max_output_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 67108864
      }
    },
    "required": [
      "argv"
    ],
    "not": {
      "required": [
        "stdin_text",
        "stdin_base64"
      ]
    },
    "additionalProperties": false
  },
  "is_world_effect": true
}
