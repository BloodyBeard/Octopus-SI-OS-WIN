{
  "id": "browser.download_cancel",
  "interface": "system_browser",
  "handler_config": {
    "operation": "download_cancel"
  },
  "process": {
    "bin": "target/debug/octopus-browser-session-tool",
    "private_read_subpaths": [
      {
        "path": "secrets/browser-native-host.auth"
      }
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": true,
      "allow_local_ipc": true
    }
  },
  "supported_worker_environment_kinds": [
    "browser_session"
  ],
  "description": "Cancel the exact previously armed download within this formed room, independently of the selected or displayed tab. An admitted native DownloadItem remains bound to its original room and target after that tab closes. This cancels its arm or native DownloadItem without closing or selecting a page.",
  "args_schema": {
    "type": "object",
    "properties": {
      "download_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      }
    },
    "required": [
      "download_id"
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
