{
  "id": "skill.search",
  "interface": "system_context",
  "process": {
    "bin": "target/debug/octopus-artifact-bound-tool",
    "authority": {
      "read_root_slots": [], "write_root_slots": [], "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [],
      "executable_commands": [], "read_env_paths": [], "write_env_paths": [],
      "executable_env_paths": [], "allow_network": false, "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": ["system_room"],
  "handler_config": { "operation": "skill_search" },
  "description": "Search only binding-visible skill.recipe artifacts. Explicit target_worker_types and interfaces are exact applicability filters; deterministic ranking retrieves candidates but never chooses or applies a skill for the model.",
  "args_schema": {
    "type": "object",
    "properties": {
      "query": { "type": "string", "minLength": 1, "maxLength": 65536 },
      "target_worker_types": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "interfaces": {
        "type": "array", "maxItems": 64, "uniqueItems": true,
        "items": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "max_results": { "type": "integer", "minimum": 1, "maximum": 20 }
    },
    "required": ["query"],
    "additionalProperties": false
  },
  "is_world_effect": false
}
