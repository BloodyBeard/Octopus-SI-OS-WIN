{
  "id": "browser.key",
  "interface": "system_browser",
  "handler_config": {
    "operation": "key"
  },
  "process": {
    "bin": "target/debug/octopus-browser-session-tool",
    "private_read_subpaths": [
      {
        "path": "secrets/browser-native-host.auth"
      }
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": true,
      "allow_local_ipc": true
    }
  },
  "supported_worker_environment_kinds": [
    "browser_session"
  ],
  "description": "Dispatch one explicit key-down/key-up pair to the current page in this formed browser room. Supply target_id to act on that exact already-owned page independently of the selected or displayed tab. Omit target_id to use the selected tab. Alternatively keys is a source-defined chord or key list using exact macOS page editing and virtual room clipboard semantics.",
  "args_schema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "modifiers": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      },
      "text": {
        "type": "string"
      },
      "target_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_-]+$",
        "description": "Exact already-owned page returned by browser.tabs or browser.tab_new. This does not select, show, create, or focus that page."
      },
      "keys": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        ]
      }
    },
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "key"
        ],
        "not": {
          "required": [
            "keys"
          ]
        }
      },
      {
        "required": [
          "keys"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "key"
              ]
            },
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "modifiers"
              ]
            }
          ]
        }
      }
    ]
  },
  "is_world_effect": true
}
