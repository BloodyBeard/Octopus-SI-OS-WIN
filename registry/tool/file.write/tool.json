{
  "id": "file.write",
  "interface": "system_room",
  "process": {
    "bin": "target/debug/octopus-file-write-tool",
    "interrupted_effect_recovery": "reinvoke_exact_artifact",
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "write_argument_paths": [
        {
          "pointer": "/path",
          "within_root_slots": [
            "run_records_root",
            "registry_artifact_root",
            "registry_interface_root",
            "registry_ee_template_root",
            "registry_mark_root",
            "registry_tool_root",
            "registry_verifier_root",
            "registry_worker_environment_kind_root",
            "ee_instances_root"
          ],
          "include_parent": true
        },
        {
          "pointer": "/writes/*/path",
          "within_root_slots": [
            "run_records_root",
            "registry_artifact_root",
            "registry_interface_root",
            "registry_ee_template_root",
            "registry_mark_root",
            "registry_tool_root",
            "registry_verifier_root",
            "registry_worker_environment_kind_root",
            "ee_instances_root"
          ],
          "include_parent": true
        }
      ],
      "allow_network": false,
      "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": [
    "system_room"
  ],
  "description": "Write one or more files under this room's granted roots. A write supplies either complete bytes or an RFC 6902 JSON patch guarded by exact before/after content hashes. Every result carries path, before_hash, and after_hash evidence; readers validate file-domain semantics fail-closed. An explicit ordered=true batch uses content and expected_before_content for each distinct path, checks each preimage immediately before its effect, and stops at the first refusal. Applied, refused, uncertain and unattempted entries are durably recorded; failure details retain partial evidence. Reinvoking the exact artifact replays those receipts without reapplying committed entries.",
  "args_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Absolute path of the file to write; must fall under one of the room's granted roots."
      },
      "content": {
        "type": "string",
        "description": "Full body to write, as a string. Written verbatim; nothing is validated here."
      },
      "patch": {
        "type": "array",
        "minItems": 1,
        "description": "RFC 6902 operations applied to the current JSON bytes. The resulting document is encoded as pretty JSON with one trailing newline.",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "op": {
                  "const": "add"
                },
                "path": {
                  "type": "string"
                },
                "value": {}
              },
              "required": [
                "op",
                "path",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "const": "remove"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "op",
                "path"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "const": "replace"
                },
                "path": {
                  "type": "string"
                },
                "value": {}
              },
              "required": [
                "op",
                "path",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "const": "move"
                },
                "from": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "op",
                "from",
                "path"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "const": "copy"
                },
                "from": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "op",
                "from",
                "path"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "op": {
                  "const": "test"
                },
                "path": {
                  "type": "string"
                },
                "value": {}
              },
              "required": [
                "op",
                "path",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "expected_before_hash": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-f]{64}$"
      },
      "expected_before_content": {
        "type": [
          "string",
          "null"
        ]
      },
      "expected_after_hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "writes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "patch": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "add"
                      },
                      "path": {
                        "type": "string"
                      },
                      "value": {}
                    },
                    "required": [
                      "op",
                      "path",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "remove"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "op",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "replace"
                      },
                      "path": {
                        "type": "string"
                      },
                      "value": {}
                    },
                    "required": [
                      "op",
                      "path",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "move"
                      },
                      "from": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "op",
                      "from",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "copy"
                      },
                      "from": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "op",
                      "from",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "test"
                      },
                      "path": {
                        "type": "string"
                      },
                      "value": {}
                    },
                    "required": [
                      "op",
                      "path",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "expected_before_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "expected_before_content": {
              "type": [
                "string",
                "null"
              ]
            },
            "expected_after_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "oneOf": [
            {
              "required": [
                "path",
                "content"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "patch"
                    ]
                  },
                  {
                    "required": [
                      "expected_after_hash"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "path",
                "patch",
                "expected_before_hash",
                "expected_after_hash"
              ],
              "properties": {
                "expected_before_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "content"
                    ]
                  },
                  {
                    "required": [
                      "expected_before_content"
                    ]
                  }
                ]
              }
            }
          ],
          "additionalProperties": false
        }
      },
      "ordered": {
        "const": true
      }
    },
    "oneOf": [
      {
        "required": [
          "path",
          "content"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "patch"
              ]
            },
            {
              "required": [
                "expected_after_hash"
              ]
            },
            {
              "required": [
                "writes"
              ]
            }
          ]
        }
      },
      {
        "required": [
          "path",
          "patch",
          "expected_before_hash",
          "expected_after_hash"
        ],
        "properties": {
          "expected_before_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "content"
              ]
            },
            {
              "required": [
                "expected_before_content"
              ]
            },
            {
              "required": [
                "writes"
              ]
            }
          ]
        }
      },
      {
        "required": [
          "writes"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "content"
              ]
            },
            {
              "required": [
                "patch"
              ]
            },
            {
              "required": [
                "expected_before_hash"
              ]
            },
            {
              "required": [
                "expected_before_content"
              ]
            },
            {
              "required": [
                "expected_after_hash"
              ]
            }
          ]
        }
      }
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "required": [
            "ordered"
          ]
        },
        "then": {
          "required": [
            "writes"
          ],
          "properties": {
            "writes": {
              "items": {
                "required": [
                  "content",
                  "expected_before_content",
                  "expected_before_hash"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "patch"
                      ]
                    },
                    {
                      "required": [
                        "expected_after_hash"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    ]
  },
  "is_world_effect": true
}
