{
  "id": "browser.history",
  "interface": "system_browser",
  "handler_config": {
    "operation": "history"
  },
  "process": {
    "bin": "target/debug/octopus-browser-session-tool",
    "private_read_subpaths": [
      {
        "path": "secrets/browser-native-host.auth"
      }
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": false,
      "allow_local_ipc": true
    }
  },
  "supported_worker_environment_kinds": [
    "browser_session"
  ],
  "description": "Query one explicitly selected native navigation-history source after its ordinary Home consent decision. The source definition must be independently bound and readable. Preparation retains the actual source epoch without querying, creating a page or Session, enrolling a collector, or granting network. Requires optional history_access configuration and an accepted owned engine receipt.",
  "args_schema": {
    "type": "object",
    "properties": {
      "source": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "array",
            "minItems": 32,
            "maxItems": 32,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "required": [
          "id",
          "content"
        ],
        "additionalProperties": false
      },
      "queries": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "from": {
        "type": "string"
      },
      "to": {
        "type": "string"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    },
    "required": [
      "source"
    ],
    "additionalProperties": false
  },
  "is_world_effect": false
}
