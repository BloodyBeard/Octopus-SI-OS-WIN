{
  "id": "file.write.telegram_gateway",
  "interface": "system_room_telegram_gateway",
  "process": {
    "bin": "target/debug/octopus-file-write-tool",
    "interrupted_effect_recovery": "reinvoke_exact_artifact",
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "write_argument_paths": [
        {"pointer": "/path", "within_root_slots": ["run_records_root", "registry_interface_root", "registry_ee_template_root", "registry_tool_root", "ee_instances_root"], "include_parent": true},
        {"pointer": "/writes/*/path", "within_root_slots": ["run_records_root", "registry_interface_root", "registry_ee_template_root", "registry_tool_root", "ee_instances_root"], "include_parent": true}
      ],
      "allow_network": false,
      "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": ["system_room"],
  "description": "Write one or more files under this room's granted roots. Every result carries path, before_hash, and after_hash evidence. The tool validates no file-domain semantics; readers validate content fail-closed.",
  "args_schema": {
    "type": "object",
    "properties": {
      "path": {"type": "string", "description": "Absolute path of the file to write; must fall under one of the room's granted roots."},
      "content": {"type": "string", "description": "Full body to write, as a string. Written verbatim; nothing is validated here."},
      "expected_before_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
      "expected_before_content": {"type": ["string", "null"]},
      "writes": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "path": {"type": "string"},
            "content": {"type": "string"},
            "expected_before_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
            "expected_before_content": {"type": ["string", "null"]}
          },
          "required": ["path", "content"],
          "additionalProperties": false
        }
      }
    },
    "oneOf": [
      {"required": ["path", "content"], "not": {"required": ["writes"]}},
      {"required": ["writes"], "not": {"anyOf": [{"required": ["path"]}, {"required": ["content"]}]}}
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
