{
  "id": "gui.app_type",
  "interface": "system_gui",
  "handler_config": {
    "operation": "app_type"
  },
  "process": {
    "bin": "target/debug/octopus-gui-session-tool",
    "private_read_subpaths": [
      {
        "path": "desktop-host/connection.json"
      }
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": true,
      "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": [
    "desktop_session"
  ],
  "description": "Type into the exact approved application using the active macOS keyboard layout. Every UTF-16 unit must map to a native key/modifier pair in that layout; LF maps to Return. The complete string is checked before focus or key dispatch. Unmappable units, unavailable keyboard-layout data, and IME/composition-only text are explicitly refused; no units are dropped and no paste is substituted. Requires current model control and an unconsumed gui.app_state observation. Observe again after any attempted action. window_id:null uses the approved app's exact current native keyboard target, never the foreground app or a global display reference.",
  "args_schema": {
    "type": "object",
    "properties": {
      "grant_request_id": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "app": {
        "type": "object",
        "properties": {
          "host_generation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "app_instance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "host_generation",
          "app_instance_id"
        ],
        "additionalProperties": false
      },
      "observation_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "revision": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "control_generation": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "window_id": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 2048
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      }
    },
    "required": [
      "grant_request_id",
      "app",
      "observation_id",
      "revision",
      "control_generation",
      "window_id",
      "text"
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
