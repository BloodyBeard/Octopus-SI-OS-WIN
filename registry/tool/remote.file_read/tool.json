{
  "id": "remote.file_read",
  "interface": "system_remote_exec",
  "process": {
    "bin": "target/debug/octopus-remote-exec-room-tool",
    "private_read_subpaths": [{"path": "secrets/remote-exec.auth"}],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": true,
      "allow_local_ipc": false
    }
  },
  "handler_config": { "operation": "file_read" },
  "supported_worker_environment_kinds": [
    "remote_exec_server"
  ],
  "description": "Read a bounded text file inside the formed remote workspace.",
  "args_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "encoding": {
        "type": "string",
        "enum": [
          "utf8",
          "base64"
        ]
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "is_world_effect": false
}
