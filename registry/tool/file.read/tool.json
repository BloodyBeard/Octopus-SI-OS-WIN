{
  "id": "file.read",
  "interface": "system_room",
  "process": {
    "bin": "target/debug/octopus-file-read-tool",
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [],
      "allow_network": false,
      "allow_local_ipc": false,
      "read_argument_paths": [
        {
          "pointer": "/path",
          "within_root_slots": [
            "run_records_root",
            "registry_artifact_root",
            "registry_interface_root",
            "registry_ee_template_root",
            "registry_mark_root",
            "registry_tool_root",
            "registry_verifier_root",
            "registry_worker_environment_kind_root",
            "ee_instances_root"
          ],
          "include_parent": false
        }
      ]
    }
  },
  "supported_worker_environment_kinds": [
    "system_room"
  ],
  "handler_config": {
    "operation": "read",
    "max_bytes": 4194304
  },
  "description": "Read UTF-8 file bytes within this room's granted roots and return their content hash for an exact subsequent file.write.",
  "args_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": "Absolute path under this room's granted roots."
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "is_world_effect": false
}
