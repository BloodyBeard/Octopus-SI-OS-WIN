{
  "id": "process.write",
  "interface": "system_exec_env",
  "handler_config": {
    "operation": "write"
  },
  "process": {
    "bin": "target/debug/octopus-process-room-tool",
    "inherit_env": [
      "PATH"
    ],
    "authority": {
      "read_root_slots": [],
      "write_root_slots": [],
      "executable_root_slots": [],
      "read_paths": [],
      "write_paths": [],
      "executable_paths": [],
      "executable_commands": [],
      "read_env_paths": [],
      "write_env_paths": [],
      "executable_env_paths": [
        "PATH"
      ],
      "allow_network": false,
      "allow_local_ipc": true
    },
    "coordinate_root_slots": []
  },
  "supported_worker_environment_kinds": [
    "process_session"
  ],
  "description": "Write text to the stdin of the persistent process in this worker environment.",
  "args_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "is_world_effect": true
}
