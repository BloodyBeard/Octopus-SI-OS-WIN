{
  "id": "skill.get",
  "interface": "system_context",
  "process": {
    "bin": "target/debug/octopus-artifact-bound-tool",
    "authority": {
      "read_root_slots": [], "write_root_slots": [], "executable_root_slots": [],
      "read_paths": [], "write_paths": [], "executable_paths": [],
      "executable_commands": [], "read_env_paths": [], "write_env_paths": [],
      "executable_env_paths": [], "allow_network": false, "allow_local_ipc": false
    }
  },
  "supported_worker_environment_kinds": ["system_room"],
  "handler_config": { "operation": "skill_get" },
  "description": "Read one bounded UTF-8 page from a binding-visible skill.recipe artifact. The recipe's exact provenance and applicability metadata accompany every page; continue with next_offset_bytes.",
  "args_schema": {
    "type": "object",
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 512 },
      "offset_bytes": { "type": "integer", "minimum": 0, "maximum": 524288 },
      "max_bytes": { "type": "integer", "minimum": 4, "maximum": 524288 }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "is_world_effect": false
}
