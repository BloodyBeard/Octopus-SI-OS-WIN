{
  "schema_version": 1,
  "mode": "gateway",
  "dependencies": {
    "install_timeout_ms": 900000,
    "keep_versions": 2
  },
  "ledger": {
    "max_row_bytes": 1048576
  },
  "discord_api": {
    "base_url_env": "OCTOPUS_DISCORD_API_BASE",
    "base_url_default": "https://discord.com/api/v10",
    "token_env": "DISCORD_BOT_TOKEN",
    "proxy_env": "OCTOPUS_DISCORD_PROXY",
    "ready_timeout_ms": 30000,
    "reconnect_backoff_ms": 1000,
    "reconnect_backoff_cap_ms": 60000
  },
  "gateway": {
    "message_content_intent": true,
    "members_intent": true,
    "voice_states_intent": true,
    "presences_intent": false,
    "status": "online",
    "activity": null
  },
  "authz": {
    "allow_all_users": false,
    "allow_all_users_env": "DISCORD_ALLOW_ALL_USERS",
    "allowed_user_ids": [],
    "allowed_user_ids_env": "DISCORD_ALLOWED_USERS",
    "allowed_role_ids": [],
    "allowed_role_ids_env": "DISCORD_ALLOWED_ROLES",
    "allowed_guild_ids": [],
    "allowed_guild_ids_env": "DISCORD_ALLOWED_GUILDS",
    "allowed_channel_ids": [],
    "allowed_channel_ids_env": "DISCORD_ALLOWED_CHANNELS",
    "denied_channel_ids": [],
    "denied_channel_ids_env": "DISCORD_DENIED_CHANNELS",
    "allow_bots": "none",
    "deny_unmatched": true,
    "pairing": {
      "enabled": true,
      "dm_only": true,
      "prompt": "You are not paired. Send this code to the operator to be approved: {code}"
    }
  },
  "gating": {
    "respond_in_dms": true,
    "require_mention_in_guilds": true,
    "free_response_channel_ids": [],
    "free_response_channel_ids_env": "DISCORD_FREE_RESPONSE_CHANNELS",
    "thread_require_mention": false,
    "reply_to_bot_counts_as_mention": true,
    "auto_thread": true,
    "no_thread_channel_ids": [],
    "no_thread_channel_ids_env": "DISCORD_NO_THREAD_CHANNELS",
    "auto_thread_archive_minutes": 1440,
    "history_backfill": true,
    "history_backfill_limit": 50,
    "text_batch_delay_ms": 600,
    "text_batch_split_delay_ms": 2000,
    "text_batch_split_threshold": 1900,
    "max_batch_events": 32,
    "max_batch_bytes": 1048576,
    "batch_lock_stripes": 64
  },
  "media": {
    "max_download_bytes": 134217728,
    "max_upload_bytes": 26214400,
    "max_attachments_per_message": 10,
    "allow_any_attachment": true,
    "inline_text_max_bytes": 102400,
    "inline_text_extensions": [
      ".txt",
      ".md",
      ".json",
      ".jsonl",
      ".csv",
      ".tsv",
      ".yaml",
      ".yml",
      ".toml",
      ".xml",
      ".html",
      ".css",
      ".js",
      ".ts",
      ".py",
      ".rs",
      ".go",
      ".java",
      ".sh"
    ]
  },
  "outbound": {
    "max_message_len": 2000,
    "min_edit_interval_ms": 750,
    "reply_mode": "first",
    "allowed_mentions": {
      "everyone": false,
      "roles": false,
      "users": true,
      "replied_user": true
    },
    "reply_labels": [
      "interface.artifact.output",
      "discord.outbound"
    ],
    "stream_labels": [
      "agent.message.delta"
    ],
    "error_labels": [
      "turn.error"
    ],
    "turn_start_labels": [
      "turn.user_message"
    ],
    "telemetry_labels": [
      "turn.reasoning",
      "turn.plan.update",
      "turn.token_usage",
      "turn.exec.command",
      "turn.web_search",
      "hook.result",
      "hook.catalog",
      "goal.status"
    ],
    "allowed_operations": [
      "message.create",
      "message.edit",
      "message.delete",
      "reaction.add",
      "reaction.remove",
      "reaction.clear",
      "typing.start",
      "typing.stop",
      "thread.create",
      "thread.edit",
      "interaction.respond",
      "voice.join",
      "voice.leave",
      "voice.play"
    ],
    "reactions": {
      "enabled": true,
      "in_progress": "👀",
      "success": "✅",
      "failure": "❌"
    },
    "typing": {
      "enabled": true,
      "refresh_seconds": 8
    },
    "rate_limit": {
      "max_retry_after_ms": 60000
    }
  },
  "commands": {
    "sync_policy": "safe",
    "mutation_interval_ms": 4500,
    "max_commands": 100,
    "commands": [
      {
        "name": "ask",
        "description": "Send a message to the bound Octopus run",
        "dm_permission": true,
        "default_member_permissions": null,
        "options": [
          {
            "name": "message",
            "description": "Message text",
            "type": "string",
            "required": true
          }
        ]
      }
    ]
  },
  "components": {
    "max_rows": 5,
    "max_items_per_row": 5,
    "max_custom_id_len": 100,
    "pending_ttl_seconds": 900
  },
  "voice": {
    "enabled": true,
    "require_opus": true,
    "silence_seconds": 1.5,
    "minimum_speech_seconds": 0.5,
    "maximum_utterance_seconds": 120,
    "inactivity_seconds": 300,
    "playback_timeout_seconds": 120,
    "max_decoded_pcm_bytes": 23040000,
    "max_buffered_pcm_bytes": 46080000,
    "max_active_speakers": 8,
    "ambient": {
      "enabled": false,
      "blob_id": null,
      "gain": 0.18,
      "duck_gain": 0.06,
      "speech_gain": 1,
      "duck_release_ms": 400
    }
  },
  "driver_ipc": {
    "listen": "127.0.0.1",
    "port": 0,
    "state_file": "driver-ipc.json",
    "connect_timeout_ms": 30000,
    "request_timeout_ms": 120000,
    "reconnect_backoff_ms": 250,
    "reconnect_backoff_cap_ms": 5000,
    "max_manifest_bytes": 1048576,
    "max_frame_bytes": 33554432
  },
  "inbound_journal": {
    "max_entries": 10000,
    "max_bytes": 134217728,
    "delivered_retention_seconds": 604800,
    "attempt_history_limit": 16,
    "delivery_max_attempts": 3,
    "delivery_retry_backoff_ms": 250,
    "delivery_retry_backoff_cap_ms": 5000,
    "private_admitted_limit": 10000,
    "max_error_chars": 4096
  },
  "private_run": {
    "ee_template": "operator_interaction",
    "parent_ee": "ee_existence",
    "model": "gpt-5.5",
    "reasoning_effort": "xhigh",
    "role_artifacts": [
      "artifact-worker-role-discord"
    ],
    "owners": {
      "discord": "world_discord",
      "provider": "world_provider_codex",
      "interface_authoring": "system_interface_authoring",
      "worker": "system_worker_discord"
    },
    "id_prefixes": {
      "run": "run_discord_",
      "ee": "ee_discord_",
      "ee_template": "operator_interaction_discord_",
      "discord": "world_discord_",
      "provider": "world_provider_codex_discord_",
      "interface_authoring": "system_interface_authoring_discord_",
      "worker": "system_worker_discord_",
      "worker_environment": "system_room_discord_",
      "file_write_tool": "file.write.discord_"
    },
    "file_write_tool": "file.write",
    "file_write_label": "tool.call",
    "file_write_result_label": "file.write.result",
    "worker_environment_kind": "system_room",
    "worker_environment_door_owner": "system_room",
    "gateway_worker_environment_interface": "system_room_discord_gateway",
    "gateway_file_write_tool": "file.write.discord_gateway",
    "file_write_mark_outcome": "tool.call.allowed",
    "provider_context_output_labels": [
      "interface.artifact.output",
      "tool.call",
      "turn.error",
      "operator.approval.request",
      "operator.elicitation.request"
    ],
    "authoring_max_attempts": 4,
    "result_timeout_ms": 30000
  },
  "gateway_run_template": {
    "id": "run_discord_gateway",
    "ee": "ee_existence",
    "worker": "system_worker_discord",
    "trace": "trace:run_discord_gateway",
    "status": "running",
    "interface_state": {},
    "checkpoints": [
      {
        "id": "cp_discord_gateway_authoring_call",
        "run": "run_discord_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "world_discord",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "system_room_discord_gateway",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-discord"
          }
        ],
        "required_verified_artifacts": [],
        "trace": "trace:run_discord_gateway:cp_discord_gateway_authoring_call"
      },
      {
        "id": "cp_discord_gateway_authoring_result",
        "run": "run_discord_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "system_room_discord_gateway",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "world_discord",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-discord"
          }
        ],
        "required_verified_artifacts": [],
        "trace": "trace:run_discord_gateway:cp_discord_gateway_authoring_result"
      }
    ],
    "active_checkpoints": [
      "cp_discord_gateway_authoring_call",
      "cp_discord_gateway_authoring_result"
    ]
  }
}
