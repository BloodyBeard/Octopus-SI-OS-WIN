{
  "id": "google_drive.copy_file",
  "request_label": "mcp.operation.request",
  "output_label": "mcp.tool.result",
  "handler_config": {
    "operation": "call_tool",
    "mcp_tool_name": "google_drive_copy_file"
  },
  "description": "Copy a Google Drive file through the external Google Drive MCP server behind world_mcp_google_drive. The mcp_tool_call family forwards this call over the interface transport wire and returns the server's result as an artifact.",
  "input_schema": {
    "type": "object",
    "properties": {
      "file": {
        "description": "File selector.",
        "oneOf": [
          {
            "type": "string",
            "description": "A Drive file ID."
          },
          {
            "type": "object",
            "properties": {
              "shared_drive_id": {
                "type": "string",
                "description": "Shared drive identifier."
              }
            }
          }
        ]
      },
      "metadata": {
        "description": "Optional copy metadata.",
        "allOf": [
          {
            "type": "object",
            "description": "Base metadata.",
            "properties": {
              "source": {
                "type": "string",
                "description": "Metadata source."
              }
            }
          }
        ]
      },
      "title": {
        "type": "string",
        "description": "Copied file title."
      }
    },
    "required": [
      "file"
    ]
  }
}
