{
  "schema_version": 1,
  "mode": "gateway",
  "ledger": {
    "max_row_bytes": 1048576
  },
  "bridge": {
    "script": "registry/interface/world_whatsapp/bridge/bridge.mjs",
    "node_bin_env": "OCTOPUS_WHATSAPP_NODE_BIN",
    "session_dir_env": "OCTOPUS_WHATSAPP_SESSION_DIR",
    "account_mode": "bot",
    "account_mode_env": "OCTOPUS_WHATSAPP_MODE",
    "pair_on_boot": true,
    "connect_timeout_ms": 60000,
    "command_timeout_ms": 120000,
    "npm_install_timeout_ms": 300000,
    "shutdown_timeout_ms": 10000,
    "reconnect_backoff_ms": 1000,
    "reconnect_backoff_cap_ms": 60000,
    "event_replay_limit": 10000,
    "effect_journal_limit": 10000,
    "max_frame_bytes": 33554432,
    "max_log_line_bytes": 16384,
    "max_log_bytes": 4194304,
    "proxy_env": "OCTOPUS_WHATSAPP_PROXY"
  },
  "authz": {
    "deny_unmatched": true,
    "allow_all_users": false,
    "allow_all_users_env": "OCTOPUS_WHATSAPP_ALLOW_ALL_USERS",
    "allowed_users": [],
    "allowed_users_env": "OCTOPUS_WHATSAPP_ALLOWED_USERS",
    "allowed_groups": [],
    "allowed_groups_env": "OCTOPUS_WHATSAPP_ALLOWED_GROUPS",
    "allow_self_chat": true,
    "allow_broadcasts": false,
    "allow_newsletters": false
  },
  "gating": {
    "respond_in_dms": true,
    "respond_in_groups": true,
    "require_mention_in_groups": true,
    "reply_to_bot_counts_as_mention": true,
    "commands_count_as_mention": true,
    "free_response_groups": [],
    "free_response_groups_env": "OCTOPUS_WHATSAPP_FREE_RESPONSE_GROUPS",
    "mention_patterns": [],
    "mention_patterns_env": "OCTOPUS_WHATSAPP_MENTION_PATTERNS",
    "text_batch_delay_ms": 900,
    "text_batch_split_delay_ms": 3500,
    "text_batch_split_threshold": 6000,
    "max_batch_events": 64,
    "max_batch_bytes": 524288
  },
  "media": {
    "max_download_bytes": 134217728,
    "max_upload_bytes": 134217728,
    "max_media_per_message": 16,
    "inline_text_max_bytes": 102400,
    "inline_text_extensions": [
      ".txt",
      ".md",
      ".json",
      ".jsonl",
      ".csv",
      ".tsv",
      ".yaml",
      ".yml",
      ".toml",
      ".xml",
      ".html",
      ".css",
      ".js",
      ".ts",
      ".py",
      ".rs",
      ".go",
      ".java",
      ".sh",
      ".log"
    ],
    "allowed_outbound_mime_prefixes": [
      "image/",
      "video/",
      "audio/",
      "text/",
      "application/"
    ]
  },
  "outbound": {
    "max_message_chars": 4096,
    "chunk_delay_ms": 300,
    "min_edit_interval_ms": 750,
    "send_timeout_ms": 60000,
    "max_retries": 3,
    "retry_backoff_ms": 500,
    "retry_backoff_cap_ms": 5000,
    "reply_prefix": "",
    "reply_labels": [
      "interface.artifact.output",
      "whatsapp.outbound"
    ],
    "stream_labels": [
      "agent.message.delta"
    ],
    "error_labels": [
      "turn.error"
    ],
    "telemetry_labels": [
      "turn.reasoning",
      "turn.plan.update",
      "turn.token_usage",
      "turn.exec.command",
      "turn.web_search",
      "hook.result",
      "hook.catalog",
      "goal.status"
    ],
    "allowed_operations": [
      "message.send",
      "message.edit",
      "message.delete",
      "reaction.set",
      "reaction.clear",
      "receipt.read",
      "typing.start",
      "typing.stop",
      "presence.set",
      "media.send",
      "location.send",
      "contact.send",
      "sticker.send",
      "poll.send",
      "interactive.buttons.send",
      "interactive.list.send",
      "interactive.template.send",
      "chat.info",
      "group.participants.update",
      "group.subject.set",
      "group.description.set",
      "group.setting.set",
      "group.invite.get",
      "group.invite.revoke",
      "group.join_requests.list",
      "group.join_requests.update",
      "group.ephemeral.set",
      "group.leave",
      "community.info",
      "community.participants.update",
      "community.subject.set",
      "community.description.set",
      "community.setting.set",
      "community.invite.get",
      "community.invite.revoke",
      "community.linked_groups.list",
      "community.join_requests.list",
      "community.join_requests.update",
      "community.member_add_mode.set",
      "community.join_approval_mode.set",
      "community.ephemeral.set",
      "community.leave"
    ],
    "typing": {
      "enabled": true,
      "refresh_seconds": 8
    },
    "read_receipts": {
      "enabled": true,
      "on_admission": true
    },
    "reactions": {
      "enabled": true,
      "in_progress": "👀",
      "success": "✅",
      "failure": "❌"
    },
    "presence": {
      "on_connect": "available",
      "on_disconnect": "unavailable"
    }
  },
  "driver_ipc": {
    "listen": "127.0.0.1",
    "port": 0,
    "state_file": "driver-ipc.json",
    "connect_timeout_ms": 30000,
    "request_timeout_ms": 120000,
    "reconnect_backoff_ms": 250,
    "reconnect_backoff_cap_ms": 5000,
    "max_manifest_bytes": 1048576,
    "max_frame_bytes": 33554432
  },
  "proactive": {
    "chat_ids": [],
    "chat_ids_env": "OCTOPUS_WHATSAPP_HOME_CHANNELS"
  },
  "context_routes": {},
  "private_run": {
    "ee_template": "operator_interaction",
    "parent_ee": "ee_existence",
    "model": "gpt-5.5",
    "reasoning_effort": "xhigh",
    "role_artifacts": [
      "artifact-worker-role-whatsapp"
    ],
    "owners": {
      "whatsapp": "world_whatsapp",
      "provider": "world_provider_codex",
      "interface_authoring": "system_interface_authoring",
      "worker": "system_worker_whatsapp"
    },
    "id_prefixes": {
      "run": "run_whatsapp_",
      "ee": "ee_whatsapp_",
      "ee_template": "operator_interaction_whatsapp_",
      "whatsapp": "world_whatsapp_",
      "provider": "world_provider_codex_whatsapp_",
      "interface_authoring": "system_interface_authoring_whatsapp_",
      "worker": "system_worker_whatsapp_",
      "worker_environment": "system_room_whatsapp_",
      "file_write_tool": "file.write.whatsapp_"
    },
    "file_write_tool": "file.write",
    "file_write_label": "tool.call",
    "file_write_result_label": "file.write.result",
    "worker_environment_kind": "system_room",
    "worker_environment_door_owner": "system_room",
    "gateway_worker_environment_interface": "system_room_whatsapp_gateway",
    "gateway_file_write_tool": "file.write.whatsapp_gateway",
    "file_write_mark_outcome": "tool.call.allowed",
    "provider_context_output_labels": [
      "interface.artifact.output",
      "tool.call",
      "turn.error",
      "operator.approval.request",
      "operator.elicitation.request"
    ],
    "authoring_max_attempts": 4,
    "result_timeout_ms": 30000
  },
  "gateway_run_template": {
    "id": "run_whatsapp_gateway",
    "ee": "ee_existence",
    "worker": "system_worker_whatsapp",
    "trace": "trace:run_whatsapp_gateway",
    "status": "running",
    "interface_state": {},
    "checkpoints": [
      {
        "id": "cp_whatsapp_gateway_authoring_call",
        "run": "run_whatsapp_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "world_whatsapp",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "system_room_whatsapp_gateway",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-whatsapp"
          }
        ],
        "required_verified_artifacts": [],
        "trace": "trace:run_whatsapp_gateway:cp_whatsapp_gateway_authoring_call"
      },
      {
        "id": "cp_whatsapp_gateway_authoring_result",
        "run": "run_whatsapp_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "system_room_whatsapp_gateway",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "world_whatsapp",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-whatsapp"
          }
        ],
        "required_verified_artifacts": [],
        "trace": "trace:run_whatsapp_gateway:cp_whatsapp_gateway_authoring_result"
      }
    ],
    "active_checkpoints": [
      "cp_whatsapp_gateway_authoring_call",
      "cp_whatsapp_gateway_authoring_result"
    ]
  }
}
