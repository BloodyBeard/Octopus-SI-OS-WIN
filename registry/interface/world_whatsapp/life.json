{
  "processes": [
    {
      "bin": "python3",
      "io_limits": {
        "max_control_frame_bytes": 1048576,
        "max_stderr_bytes": 262144,
        "max_manifest_bytes": 1048576,
        "max_payload_bytes": 268435456
      },
      "args": [
        {
          "repository_file": "registry/interface/world_whatsapp/octopus_python_boot.py"
        },
        {
          "repository_file": "registry/interface/world_whatsapp/whatsapp_life.py"
        }
      ],
      "private_var_directories": [
        "bridge-runtime",
        "content-hash-python-runtime"
      ],
      "required_files": [
        "registry/interface/world_whatsapp/octopus_python_boot.py",
        "registry/interface/world_whatsapp/whatsapp_life.py",
        "registry/interface/world_whatsapp/octopus_content_hash.py",
        "registry/interface/world_whatsapp/requirements-content-hash.lock",
        "registry/interface/world_whatsapp/bridge/bridge.mjs",
        "registry/interface/world_whatsapp/bridge/allowlist.mjs",
        "registry/interface/world_whatsapp/bridge/redaction.mjs",
        "registry/interface/world_whatsapp/bridge/package.json",
        "registry/interface/world_whatsapp/bridge/package-lock.json"
      ],
      "inherit_env": [
        "OCTOPUS_WHATSAPP_SESSION_DIR",
        "OCTOPUS_WHATSAPP_NODE_BIN",
        "OCTOPUS_WHATSAPP_MODE",
        "OCTOPUS_WHATSAPP_ALLOWED_USERS",
        "OCTOPUS_WHATSAPP_ALLOWED_GROUPS",
        "OCTOPUS_WHATSAPP_FREE_RESPONSE_GROUPS",
        "OCTOPUS_WHATSAPP_MENTION_PATTERNS",
        "OCTOPUS_WHATSAPP_ALLOW_ALL_USERS",
        "OCTOPUS_WHATSAPP_PROXY",
        "OCTOPUS_WHATSAPP_HOME_CHANNELS",
        "NODE_PATH",
        "PATH"
      ],
      "authority": {
        "read_root_slots": [
          "registry_ee_template_root",
          "registry_interface_root",
          "registry_tool_root",
          "registry_worker_environment_kind_root",
          "run_records_root",
          "ee_instances_root"
        ],
        "write_root_slots": [],
        "executable_root_slots": [],
        "read_paths": [],
        "write_paths": [],
        "executable_paths": [],
        "executable_commands": [
          "python3",
          "node",
          "npm",
          "ffmpeg"
        ],
        "read_env_paths": [],
        "write_env_paths": [],
        "executable_env_paths": [],
        "executable_env_subpaths": [
          {
            "env": "OCTOPUS_VAR_DIR",
            "relative_path": "bridge-runtime"
          },
          {
            "env": "OCTOPUS_VAR_DIR",
            "relative_path": "content-hash-python-runtime"
          }
        ],
        "allow_network": true,
        "allow_local_ipc": true
      },
      "coordinate_root_slots": [
        "registry_ee_template_root",
        "registry_interface_root",
        "registry_tool_root",
        "registry_worker_environment_kind_root",
        "run_records_root",
        "ee_instances_root"
      ],
      "read_handles": [
        "ledger",
        "blobs",
        "ledger_index"
      ]
    }
  ]
}
