{
  "processes": [
    {
      "bin": "python3",
      "io_limits": {
        "max_control_frame_bytes": 1048576,
        "max_stderr_bytes": 262144,
        "max_manifest_bytes": 1048576,
        "max_payload_bytes": 268435456
      },
      "args": [
        {
          "repository_file": "registry/interface/world_external_import/external_import_life.py"
        }
      ],
      "private_var_directories": [
        "payloads",
        "effects"
      ],
      "required_files": [
        "registry/interface/world_external_import/external_import_life.py",
        "registry/interface/world_external_import/external_import_contract.py",
        "registry/interface/world_external_import/octopus_content_hash.py",
        "registry/interface/world_external_import/config.json"
      ],
      "inherit_env": [
        "PATH"
      ],
      "authority": {
        "read_root_slots": [
          "external_import_source_root"
        ],
        "write_root_slots": [],
        "executable_root_slots": [],
        "read_paths": [],
        "write_paths": [],
        "executable_paths": [],
        "executable_commands": [
          "python3"
        ],
        "read_env_paths": [],
        "write_env_paths": [],
        "executable_env_paths": [],
        "allow_network": false,
        "allow_local_ipc": false
      },
      "coordinate_root_slots": [
        "external_import_source_root"
      ],
      "read_handles": [
        "ledger",
        "blobs"
      ]
    }
  ]
}
