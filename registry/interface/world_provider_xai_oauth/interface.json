{
  "id": "world_provider_xai_oauth",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "xai_oauth"
  ],
  "interface_driver_ref": "openai_responses_native",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 5
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": [
          "grok-build-0.1"
        ]
      }
    }
  },
  "interface_driver_config": {
    "private_config": {
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "process_env_names": [],
      "model_hidden_tools": [
        "file.write"
      ],
      "model": "grok-build-0.1",
      "base_url_source": "descriptor",
      "auth_source": "secret",
      "oauth": {
        "schema_version": 1,
        "credentials_secret_ref": "secret://world_provider_xai_oauth/XAI_OAUTH_CREDENTIALS_V1",
        "access_token_cache_secret_ref": "secret://world_provider_xai_oauth/XAI_OAUTH_ACCESS_TOKEN_CACHE_V1",
        "login_state_secret_ref": "secret://world_provider_xai_oauth/XAI_OAUTH_LOGIN_STATE_V1",
        "refresh_journal_secret_ref": "secret://world_provider_xai_oauth/XAI_OAUTH_REFRESH_JOURNAL_V1",
        "refresh_skew_seconds": 3600,
        "login_state_ttl_seconds": 900,
        "request_timeout_ms": 20000,
        "max_response_bytes": 1048576,
        "flow": {
          "kind": "xai_oidc_pkce",
          "discovery_endpoint": "https://auth.x.ai/.well-known/openid-configuration",
          "client_id": "b1a00492-073a-47ea-816f-4c329264a828",
          "redirect_uri": "http://127.0.0.1:56121/callback",
          "scope": "openid profile email offline_access grok-cli:access api:access",
          "authorization_parameters": {
            "plan": "generic",
            "referrer": "hermes-agent"
          }
        }
      },
      "context_output_labels": [
        "interface.artifact.output",
        "provider.reasoning",
        "provider.native_tool",
        "provider.tool_results.pending",
        "tool.call",
        "turn.error",
        "provider.auth.login.action",
        "provider.auth.status",
        "provider.auth.logout.completed"
      ],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "provider.reasoning",
        "provider.native_tool",
        "provider.tool_results.pending",
        "tool.call",
        "turn.error"
      ],
      "model_catalog": [
        {
          "model": "grok-build-0.1",
          "display_name": "Grok Build 0.1 (xAI OAuth)",
          "context_window": 256000,
          "max_output_tokens": 64000,
          "input_modalities": ["text"],
          "output_modalities": ["text"],
          "show_in_picker": true
        }
      ],
      "responses_api": {
        "operation": {
          "method": "post",
          "path": "/v1/responses",
          "response_mode": "sse",
          "sequence_numbers": "optional_monotonic"
        },
        "request_fields": {
          "store": false,
          "reasoning": {
            "effort": "high",
            "summary": "auto"
          },
          "include": [
            "reasoning.encrypted_content",
            "web_search_call.action.sources",
            "code_interpreter_call.outputs"
          ]
        },
        "cache": {
          "mode": "static_prefix_blake3",
          "field": "prompt_cache_key",
          "prefix": "pck_",
          "digest_characters": 24
        },
        "retry": {
          "backoff_ms": 1000,
          "max_backoff_ms": 8000,
          "http_statuses": [
            408,
            409,
            425,
            429,
            500,
            502,
            503,
            504
          ]
        },
        "model_catalog": {
          "path": "/v1/language-models",
          "request_label": "provider.models.list",
          "output_label": "provider.models.catalog",
          "models_pointer": "/models",
          "id_pointer": "/id"
        },
        "function_tools": {
          "strict": false,
          "tool_choice": "auto",
          "parallel_tool_calls": true
        },
        "native_tools": [
          {
            "type": "web_search"
          },
          {
            "type": "x_search"
          },
          {
            "type": "code_interpreter"
          }
        ],
        "native_tool_types": [
          "web_search",
          "x_search",
          "code_interpreter"
        ],
        "native_tool_output_types": [
          "web_search_call",
          "x_search_call",
          "code_interpreter_call"
        ],
        "response_item_types": [
          "message",
          "reasoning",
          "function_call",
          "web_search_call",
          "x_search_call",
          "code_interpreter_call"
        ],
        "response_content_types": [
          "output_text",
          "refusal",
          "encrypted_content"
        ],
        "replay": {
          "scope": "xai-oauth-responses-api",
          "encrypted_reasoning": true,
          "encrypted_content": true,
          "assistant_messages": true,
          "native_tool_items": true,
          "foreign_encrypted": "drop",
          "strip_item_ids": [
            "message",
            "reasoning",
            "function_call",
            "web_search_call",
            "x_search_call",
            "code_interpreter_call"
          ]
        },
        "carrier_policy": {
          "max_inline_file_bytes": 20971520,
          "allowed_roles": [
            "user",
            "assistant",
            "system",
            "developer"
          ],
          "allowed_input_item_types": [
            "message"
          ],
          "allowed_content_types": [
            "input_text",
            "output_text",
            "input_image",
            "input_file",
            "encrypted_content"
          ],
          "allowed_image_details": [
            "auto",
            "low",
            "high"
          ],
          "allowed_file_details": [
            "auto",
            "low",
            "high"
          ],
          "allowed_image_url_schemes": [
            "https",
            "data"
          ],
          "allowed_file_url_schemes": [
            "https"
          ],
          "rules": [
            {
              "label": "interface.input",
              "encoding": "json_text",
              "role": "user",
              "text_pointer": "/prompt"
            },
            {
              "label": "responses.input",
              "encoding": "responses_items",
              "items_pointer": "/items"
            }
          ]
        },
        "evidence_headers": [
          "x-request-id"
        ],
        "usage_required": true
      }
    },
    "transport": {
      "base_url": "https://api.x.ai",
      "wire": "openai_responses_native",
      "auth_secret_ref": "secret://world_provider_xai_oauth/XAI_OAUTH_ACCESS_TOKEN_CACHE_V1",
      "auth_header": "Authorization",
      "auth_value_prefix": "Bearer ",
      "headers": {},
      "request_timeout_ms": 900000,
      "max_response_bytes": 134217728
    }
  }
}
