{
  "id": "remote_operator.deliver",
  "request_label": "remote_operator.request",
  "output_label": "remote_operator.delivery",
  "handler_config": {
    "operation": "deliver"
  },
  "description": "Deliver one artifact-native JSON message to one paired client stream. The private wire may segment and buffer it, but app-server methods, thread/session ids, provider calls, and hidden routing are not accepted.",
  "input_schema": {
    "type": "object",
    "properties": {
      "client_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "stream_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "message": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "schema_version",
          "label",
          "payload"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "client_id",
      "stream_id",
      "message"
    ],
    "additionalProperties": false
  }
}
