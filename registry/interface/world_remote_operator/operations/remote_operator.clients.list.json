{
  "id": "remote_operator.clients.list",
  "request_label": "remote_operator.request",
  "output_label": "remote_operator.client_catalog",
  "handler_config": {
    "operation": "clients.list"
  },
  "description": "List paired clients for one exact environment with cursor pagination, a 1..100 limit, and ascending or descending order.",
  "input_schema": {
    "type": "object",
    "properties": {
      "environment_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 100
      },
      "order": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "default": "desc"
      }
    },
    "required": [
      "environment_id"
    ],
    "additionalProperties": false
  }
}
