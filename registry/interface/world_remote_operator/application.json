{
  "schema_version": 3,
  "id": "world_remote_operator",
  "name": "Remote Operator",
  "description": "Pair a private remote operator client and exchange artifact-native operator input, status, and delivery evidence.",
  "category": "connector",
  "developer": "Octopus",
  "version": "1.0.0",
  "icon": "mobile",
  "logo": "application-logo.svg",
  "interfaces": [
    "world_remote_operator"
  ],
  "artifact_bindings": [
    {
      "artifact_id": "artifact-application-remote-operator-context",
      "label": "Remote Operator capability contract"
    }
  ],
  "task_capabilities": {
    "tools": [
      {
        "tool": "artifact.send",
        "interface": "system_room",
        "worker_environment_kind": "system_room"
      }
    ]
  },
  "setup": {
    "fields": [
      {
        "interface": "world_remote_operator",
        "pointer": "/interface_driver_config/transport/base_url_env",
        "label": "Remote operator service URL",
        "kind": "url",
        "required": true
      },
      {
        "interface": "world_remote_operator",
        "pointer": "/interface_driver_config/transport/auth_env_key",
        "label": "Remote operator account token",
        "kind": "secret",
        "required": true
      },
      {
        "interface": "world_remote_operator",
        "pointer": "/interface_driver_config/private_config/auth_kind_env",
        "label": "Auth kind (chatgpt_account)",
        "kind": "text",
        "required": true
      },
      {
        "interface": "world_remote_operator",
        "pointer": "/interface_driver_config/private_config/account_id_env",
        "label": "Remote operator account id",
        "kind": "secret",
        "required": true
      },
      {
        "interface": "world_remote_operator",
        "pointer": "/interface_driver_config/private_config/server_name_env",
        "label": "Operator-visible server name",
        "kind": "text",
        "required": true
      },
      {
        "interface": "world_remote_operator",
        "pointer": "/interface_driver_config/private_config/installation_id_env",
        "label": "Installation identity",
        "kind": "secret",
        "required": true
      }
    ]
  }
}
