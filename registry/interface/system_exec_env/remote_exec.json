{
  "schema_version": 1,
  "websocket_url": "ws://127.0.0.1:8765",
  "auth_secret_handle": "secrets/remote-exec.auth",
  "workspace_uri": "file:///workspace",
  "request_timeout_ms": 120000,
  "max_output_bytes": 8388608,
  "max_file_bytes": 8388608,
  "max_stdin_bytes": 8388608,
  "max_processes": 64,
  "max_list_entries": 10000,
  "env_inherit": "core",
  "env_override_allowlist": [
    "CI",
    "LANG",
    "LC_ALL",
    "TERM"
  ]
}
