{
  "processes": [
    {
      "bin": "target/debug/octopus-filesystem-workspace-tool-door-life",
      "io_limits": {
        "max_control_frame_bytes": 1048576,
        "max_stderr_bytes": 262144,
        "max_manifest_bytes": 1048576,
        "max_payload_bytes": 268435456
      },
      "args": [],
      "inherit_env": ["HOME", "OCTOPUS_HOME", "PATH"],
      "authority": {
        "read_root_slots": ["registry_interface_root", "registry_tool_root", "registry_worker_environment_kind_root", "workspace_root"],
        "write_root_slots": ["workspace_root"],
        "executable_root_slots": ["workspace_root"],
        "optional_read_root_slots": ["host_filesystem_root", "platform_toolchain_root", "tool_cache_root", "toolchain_root"],
        "optional_write_root_slots": ["host_filesystem_root", "platform_toolchain_root"],
        "optional_executable_root_slots": ["host_filesystem_root", "platform_toolchain_root", "tool_cache_root", "toolchain_root"],
        "read_paths": [],
        "write_paths": [],
        "executable_paths": ["target/debug/octopus-workspace-exec-tool", "target/debug/octopus-workspace-fs-tool"],
        "executable_commands": ["git", "sh", "bash", "zsh"],
        "read_env_paths": [],
        "write_env_paths": [],
        "executable_env_paths": ["PATH"],
        "allow_network": true,
        "allow_local_ipc": true,
        "allow_sandbox_delegation": true
      },
      "coordinate_root_slots": ["interface_life_install_root", "registry_interface_root", "registry_tool_root", "registry_worker_environment_kind_root", "workspace_root"],
      "read_handles": ["ledger", "ledger_index", "blobs"]
    }
  ]
}
