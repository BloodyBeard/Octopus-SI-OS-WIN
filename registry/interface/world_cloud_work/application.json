{
  "schema_version": 3,
  "id": "world_cloud_work",
  "name": "Cloud Work",
  "description": "Create and inspect managed cloud work with explicit attempts, progress, results, and non-applied diff handoffs.",
  "category": "plugin",
  "developer": "Octopus",
  "version": "1.0.0",
  "icon": "cloud",
  "logo": "application-logo.svg",
  "interfaces": [
    "world_cloud_work"
  ],
  "artifact_bindings": [
    {
      "artifact_id": "artifact-application-cloud-work-context",
      "label": "Cloud Work capability contract"
    }
  ],
  "task_capabilities": {
    "tools": [
      {
        "tool": "artifact.send",
        "interface": "system_room",
        "worker_environment_kind": "system_room"
      }
    ]
  },
  "setup": {
    "fields": [
      {
        "interface": "world_cloud_work",
        "pointer": "/interface_driver_config/transport/base_url_env",
        "label": "Cloud service URL",
        "kind": "url",
        "required": true
      },
      {
        "interface": "world_cloud_work",
        "pointer": "/interface_driver_config/transport/auth_env_key",
        "label": "Cloud service token",
        "kind": "secret",
        "required": true
      },
      {
        "interface": "world_cloud_work",
        "pointer": "/interface_driver_config/private_config/account_id_env",
        "label": "Cloud account id",
        "kind": "secret",
        "required": false
      }
    ]
  }
}
