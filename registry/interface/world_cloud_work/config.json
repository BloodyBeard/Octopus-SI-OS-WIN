{
  "schema_version": 1,
  "transport": {
    "base_url_env": "CLOUD_WORK_BASE_URL",
    "auth_token_env": "CLOUD_WORK_AUTH_TOKEN",
    "account_id_env": "CLOUD_WORK_ACCOUNT_ID",
    "request_timeout_ms": 120000,
    "max_response_bytes": 33554432,
    "user_agent": "octopus-cloud-work/1"
  },
  "contract": {
    "accepted_labels": [
      "cloud_work.request"
    ],
    "max_prompt_chars": 200000,
    "max_task_id_chars": 512,
    "max_cursor_chars": 4096,
    "max_list_limit": 20,
    "max_attempts": 4,
    "max_diff_bytes": 134217728,
    "operation_catalog_dir": "operations"
  },
  "driver_ipc": {
    "ledger_batch_size": 64,
    "idle_sleep_ms": 100,
    "verdict_timeout_ms": 30000,
    "max_cached_manifest_bytes": 1048576,
    "max_outbound_payload_bytes": 268435456,
    "ledger_fallback_max_line_bytes": 8388608
  }
}
