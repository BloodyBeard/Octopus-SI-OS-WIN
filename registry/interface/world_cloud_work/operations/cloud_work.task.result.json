{
  "id": "cloud_work.task.result",
  "request_label": "cloud_work.request",
  "output_label": "cloud_work.result",
  "handler_config": {
    "operation": "task.result"
  },
  "description": "Read the original prompt and assistant result messages for the current or selected attempt without collapsing attempt identity.",
  "input_schema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "attempt_placement": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
      },
      "turn_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "required": [
      "task_id"
    ],
    "additionalProperties": false
  }
}
