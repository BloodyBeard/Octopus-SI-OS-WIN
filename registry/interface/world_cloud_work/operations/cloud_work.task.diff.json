{
  "id": "cloud_work.task.diff",
  "request_label": "cloud_work.request",
  "output_label": "cloud_work.diff",
  "handler_config": {
    "operation": "task.diff"
  },
  "description": "Read the unified diff for the current or selected attempt and emit its exact bytes plus digest as evidence. This operation never applies it.",
  "input_schema": {
    "type": "object",
    "properties": {
      "task_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "attempt_placement": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
      },
      "turn_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "required": [
      "task_id"
    ],
    "additionalProperties": false
  }
}
