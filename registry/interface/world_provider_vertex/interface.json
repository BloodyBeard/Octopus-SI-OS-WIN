{
  "id": "world_provider_vertex",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "vertex"
  ],
  "interface_driver_config": {
    "private_config": {
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "model_hidden_tools": [
        "file.write"
      ],
      "process_env_names": [
        "OCTOPUS_VERTEX_GEMINI_BASE_URL"
      ],
      "header_env": {},
      "model": "gemini-2.5-pro",
      "operation": "stream_generate_content",
      "base_url_source": "environment",
      "base_url_allowed_host_suffixes": [
        "us-central1-aiplatform.googleapis.com"
      ],
      "auth_source": "google_service_account_jwt",
      "service_account_jwt": {
        "credential_secret_ref": "secret://world_provider_vertex/GOOGLE_SERVICE_ACCOUNT_JSON",
        "token_url": "https://oauth2.googleapis.com/token",
        "scopes": [
          "https://www.googleapis.com/auth/cloud-platform"
        ],
        "assertion_lifetime_seconds": 3600,
        "refresh_skew_seconds": 300
      },
      "generation_config": {
        "candidateCount": 1,
        "maxOutputTokens": 65535
      },
      "safety_settings": [],
      "tool_config": {
        "functionCallingConfig": {
          "mode": "AUTO"
        }
      },
      "finish_policy": {
        "successful_reasons": [
          "STOP"
        ],
        "nonreplayable_reasons": [
          "MAX_TOKENS"
        ]
      },
      "retry": {
        "transport": true,
        "retryable_http_statuses": [
          408,
          429,
          500,
          502,
          503,
          504
        ],
        "backoff_ms": [
          1000,
          2000,
          4000,
          8000
        ]
      },
      "carrier_policy": {
        "max_inline_bytes": 20971520,
        "allowed_modalities": [
          "text",
          "image",
          "audio",
          "video",
          "file"
        ],
        "allowed_mime_types": [
          "image/*",
          "audio/*",
          "video/*",
          "text/*",
          "application/json",
          "application/pdf"
        ],
        "allowed_file_uri_schemes": [
          "https",
          "gs"
        ],
        "rules": [
          {
            "label": "interface.input",
            "encoding": "json_text",
            "role": "user",
            "text_pointer": "/prompt"
          },
          {
            "label": "gemini.content",
            "encoding": "gemini_content"
          }
        ]
      },
      "context_output_labels": [
        "interface.artifact.output",
        "tool.call",
        "turn.error"
      ],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "turn.error"
      ]
    },
    "transport": {
      "base_url": "",
      "base_url_env": "OCTOPUS_VERTEX_GEMINI_BASE_URL",
      "wire": "gemini_stream_generate_content",
      "auth_header": "Authorization",
      "auth_value_prefix": "Bearer ",
      "request_timeout_ms": 600000,
      "max_response_bytes": 67108864
    }
  },
  "interface_driver_ref": "gemini_native",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 5
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": [
          "gemini-2.5-pro"
        ]
      }
    }
  }
}
