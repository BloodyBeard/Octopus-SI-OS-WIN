{
  "schema_version": 3,
  "id": "world_provider_together",
  "name": "Together AI",
  "description": "Open models through a Together AI API key.",
  "category": "provider",
  "developer": "Together AI",
  "version": "1.0.0",
  "icon": "sparkles",
  "logo": "application-logo.svg",
  "interfaces": [
    "world_provider_together"
  ],
  "setup": {
    "fields": [
      {
        "interface": "world_provider_together",
        "pointer": "/interface_driver_config/transport/auth_env_key",
        "label": "Together API key",
        "kind": "secret",
        "required": true
      },
      {
        "interface": "world_provider_together",
        "pointer": "/interface_driver_config/private_config/opencodex/model_env",
        "label": "Model id, for example openai/gpt-oss-120b",
        "kind": "text",
        "required": true
      }
    ]
  }
}
