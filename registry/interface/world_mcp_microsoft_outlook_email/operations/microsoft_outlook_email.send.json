{
  "id": "microsoft_outlook_email.send",
  "request_label": "mcp.operation.request",
  "output_label": "mcp.tool.result",
  "handler_config": {
    "operation": "call_tool",
    "mcp_tool_name": "microsoft_outlook_email_send"
  },
  "description": "Send an Outlook email through the external Microsoft Outlook MCP server behind world_mcp_microsoft_outlook_email. The mcp_tool_call family forwards this call over the interface transport wire and returns the server's result as an artifact.",
  "input_schema": {
    "type": "object",
    "properties": {
      "message_id": {
        "$ref": "#/$defs/Message/properties/id"
      },
      "attachment": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Attachment"
        }
      }
    },
    "$defs": {
      "Message": {
        "type": "object",
        "description": "Outlook message.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Message identifier."
          },
          "sender": {
            "$ref": "#/$defs/EmailAddress"
          },
          "importance": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ],
            "description": "Message importance."
          }
        }
      },
      "Attachment": {
        "type": "object",
        "description": "Email attachment.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Attachment file name."
          }
        }
      },
      "EmailAddress": {
        "type": "object",
        "description": "Email address object.",
        "properties": {
          "address": {
            "type": "string",
            "description": "SMTP address."
          }
        }
      }
    }
  }
}
