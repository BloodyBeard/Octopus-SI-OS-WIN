{
  "id": "world_provider_bedrock",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "bedrock"
  ],
  "interface_driver_ref": "aws_bedrock_converse",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 4
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": [
          "us.anthropic.claude-sonnet-4-6"
        ]
      }
    }
  },
  "interface_driver_config": {
    "private_config": {
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "process_env_names": [
        "AWS_ACCESS_KEY_ID",
        "AWS_CONFIG_FILE",
        "AWS_CONTAINER_AUTHORIZATION_TOKEN",
        "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE",
        "AWS_CONTAINER_CREDENTIALS_FULL_URI",
        "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
        "AWS_ROLE_ARN",
        "AWS_ROLE_SESSION_NAME",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_SHARED_CREDENTIALS_FILE",
        "AWS_SSO_CACHE_FILE",
        "AWS_WEB_IDENTITY_TOKEN_FILE"
      ],
      "model_hidden_tools": [
        "file.write"
      ],
      "model": "us.anthropic.claude-sonnet-4-6",
      "context_output_labels": [
        "interface.artifact.output",
        "provider.reasoning",
        "provider.error",
        "provider.tool_results.pending",
        "tool.call"
      ],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "provider.tool_results.pending",
        "provider.error"
      ],
      "bedrock_converse": {
        "operation": "converse_stream",
        "region": "us-east-1",
        "signing_name": "bedrock",
        "paths": {
          "converse": "/model/{model}/converse",
          "converse_stream": "/model/{model}/converse-stream"
        },
        "authorization": {
          "scheme": "sigv4",
          "credentials": {
            "kind": "chain",
            "sources": [
              {
                "kind": "environment",
                "access_key_env": "AWS_ACCESS_KEY_ID",
                "secret_key_env": "AWS_SECRET_ACCESS_KEY",
                "session_token_env": "AWS_SESSION_TOKEN"
              },
              {
                "kind": "secret_handles",
                "access_key_ref": "secret://world_provider_bedrock/AWS_ACCESS_KEY_ID",
                "secret_key_ref": "secret://world_provider_bedrock/AWS_SECRET_ACCESS_KEY",
                "session_token_ref": "secret://world_provider_bedrock/AWS_SESSION_TOKEN"
              },
              {
                "kind": "profile",
                "profile": "default",
                "credentials_file_env": "AWS_SHARED_CREDENTIALS_FILE",
                "config_file_env": "AWS_CONFIG_FILE",
                "max_role_depth": 8,
                "sts": {
                  "endpoint": "https://sts.us-east-1.amazonaws.com",
                  "region": "us-east-1",
                  "signing_name": "sts",
                  "default_role_session_name": "octopus-bedrock",
                  "timeout_ms": 5000,
                  "max_response_bytes": 262144
                },
                "sso_cache_file_env": "AWS_SSO_CACHE_FILE",
                "sso_portal_domain": "amazonaws.com"
              },
              {
                "kind": "web_identity",
                "role_arn_env": "AWS_ROLE_ARN",
                "token_file_env": "AWS_WEB_IDENTITY_TOKEN_FILE",
                "role_session_name_env": "AWS_ROLE_SESSION_NAME",
                "default_role_session_name": "octopus-bedrock-web",
                "duration_seconds": 3600,
                "sts": {
                  "endpoint": "https://sts.us-east-1.amazonaws.com",
                  "region": "us-east-1",
                  "signing_name": "sts",
                  "default_role_session_name": "octopus-bedrock-web",
                  "timeout_ms": 5000,
                  "max_response_bytes": 262144
                }
              },
              {
                "kind": "ecs_container",
                "relative_uri_env": "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
                "full_uri_env": "AWS_CONTAINER_CREDENTIALS_FULL_URI",
                "authorization_token_env": "AWS_CONTAINER_AUTHORIZATION_TOKEN",
                "authorization_token_file_env": "AWS_CONTAINER_AUTHORIZATION_TOKEN_FILE",
                "relative_base_url": "http://169.254.170.2",
                "allowed_full_uri_hosts": [
                  "169.254.170.2",
                  "169.254.170.23",
                  "fd00:ec2::23",
                  "localhost",
                  "127.0.0.1",
                  "::1"
                ],
                "timeout_ms": 2000,
                "max_response_bytes": 262144
              },
              {
                "kind": "imds_v2",
                "endpoint": "http://169.254.169.254",
                "token_ttl_seconds": 21600,
                "timeout_ms": 1000,
                "max_response_bytes": 262144
              }
            ]
          }
        },
        "inference_config": {
          "maxTokens": 32768
        },
        "request_fields": {},
        "tools_enabled": true,
        "tool_choice": null,
        "reasoning_replay": "verbatim",
        "input_content_types": [
          "text",
          "image",
          "document",
          "reasoningContent",
          "toolUse",
          "toolResult"
        ],
        "response_content_types": [
          "text",
          "reasoningContent",
          "toolUse",
          "toolResult",
          "image",
          "citationsContent"
        ],
        "carrier_policy": {
          "max_inline_bytes": 26214400,
          "max_images_per_message": 20,
          "max_documents_per_message": 5,
          "max_image_bytes": 3932160,
          "max_document_bytes": 4718592,
          "allowed_image_formats": [
            "png",
            "jpeg",
            "gif",
            "webp"
          ],
          "allowed_document_formats": [
            "pdf",
            "csv",
            "doc",
            "docx",
            "xls",
            "xlsx",
            "html",
            "txt",
            "md"
          ],
          "rules": [
            {
              "encoding": "json_text",
              "label": "interface.input",
              "role": "user",
              "text_pointer": "/prompt"
            },
            {
              "encoding": "bedrock_message",
              "label": "bedrock.message"
            }
          ]
        },
        "account_limits": {
          "max_in_flight": 1,
          "requests_per_window": 120,
          "window_ms": 60000,
          "max_request_bytes": 26214400,
          "max_messages": 2048,
          "max_content_blocks": 8192,
          "max_tools": 256,
          "max_tool_input_bytes": 1048576
        },
        "retry": {
          "transport": true,
          "auth_transport": true,
          "base_delay_ms": 1000,
          "max_delay_ms": 30000,
          "retryable_statuses": [
            408,
            429,
            500,
            502,
            503,
            504
          ],
          "retryable_error_codes": [
            "InternalServerException",
            "ModelNotReadyException",
            "ModelTimeoutException",
            "ServiceQuotaExceededException",
            "ServiceUnavailableException",
            "ThrottlingException"
          ]
        },
        "model_catalog": {
          "request_label": "provider.models.list",
          "output_label": "provider.models.catalog",
          "base_url": "https://bedrock.us-east-1.amazonaws.com",
          "signing_name": "bedrock",
          "operations": [
            {
              "kind": "foundation_models",
              "method": "GET",
              "path": "/foundation-models",
              "max_pages": 1,
              "page_size": null,
              "type_equals": null
            },
            {
              "kind": "inference_profiles",
              "method": "GET",
              "path": "/inference-profiles",
              "max_pages": 32,
              "page_size": 1000,
              "type_equals": null
            }
          ]
        }
      }
    },
    "transport": {
      "base_url": "https://bedrock-runtime.us-east-1.amazonaws.com",
      "wire": "aws_bedrock_converse_stream",
      "headers": {
        "accept": "application/vnd.amazon.eventstream",
        "content-type": "application/json"
      },
      "request_timeout_ms": 600000,
      "max_response_bytes": 268435456
    }
  }
}
