{
  "id": "slack.schedule_message",
  "request_label": "mcp.operation.request",
  "output_label": "mcp.tool.result",
  "handler_config": {
    "operation": "call_tool",
    "mcp_tool_name": "slack_schedule_message"
  },
  "description": "Schedule a Slack message through the external Slack MCP server behind world_mcp_slack. The mcp_tool_call family forwards this call over the interface transport wire and returns the server's result as an artifact.",
  "input_schema": {
    "type": "object",
    "properties": {
      "channel_id": {
        "type": "string",
        "description": "Slack channel ID."
      },
      "message": {
        "type": "string",
        "description": "Message text."
      },
      "post_at": {
        "type": "integer",
        "description": "Unix timestamp for delivery."
      },
      "thread_ts": {
        "description": "Optional parent thread timestamp.",
        "anyOf": [
          {
            "$ref": "#/$defs/SlackTs"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "channel_id",
      "message",
      "post_at"
    ],
    "additionalProperties": false,
    "$defs": {
      "SlackTs": {
        "type": "string",
        "description": "Slack timestamp string.",
        "pattern": "^[0-9]+[.][0-9]+$"
      }
    }
  }
}
