{
  "id": "world_provider_github_copilot_acp",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "provider.github_copilot_acp"
  ],
  "interface_driver_ref": "github_copilot_acp",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 3
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": [
          "gpt-5.4"
        ]
      }
    }
  },
  "interface_driver_config": {
    "supported_reasoning_efforts": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "private_config": {
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "process_env_names": [
        "PATH"
      ],
      "model_hidden_tools": [
        "file.write"
      ],
      "model": "gpt-5.4",
      "github_copilot_acp": {
        "command": "copilot",
        "args": [
          "--acp",
          "--stdio",
          "--model=gpt-5.4",
          "--effort=high",
          "--available-tools=view",
          "--disable-builtin-mcps",
          "--disallow-temp-dir",
          "--no-ask-user",
          "--no-auto-update",
          "--no-custom-instructions",
          "--no-experimental",
          "--no-remote",
          "--no-remote-export",
          "--secret-env-vars=COPILOT_GITHUB_TOKEN"
        ],
        "model": "gpt-5.4",
        "protocol_version": 1,
        "client_info": {
          "name": "octopus",
          "title": "Octopus GitHub Copilot ACP interface",
          "version": "0.1.0"
        },
        "request_timeout_ms": 900000,
        "max_control_frame_bytes": 8388608,
        "max_stderr_bytes": 262144,
        "max_inline_data_bytes": 20971520,
        "retry_backoff_ms": [
          1000,
          4000
        ],
        "allowed_input_labels": [
          "context.reference",
          "interface.input",
          "interface.artifact.output",
          "turn.error"
        ],
        "session_replay_labels": [
          "interface.input",
          "interface.artifact.output",
          "turn.error"
        ],
        "allowed_session_updates": [
          "agent_message_chunk",
          "agent_thought_chunk",
          "available_commands_update",
          "config_options_update",
          "current_mode_update",
          "plan",
          "session_info_update",
          "tool_call",
          "tool_call_update",
          "usage_update",
          "user_message_chunk"
        ],
        "successful_stop_reasons": [
          "end_turn"
        ],
        "nonreplayable_stop_reasons": [
          "max_tokens"
        ],
        "process_env_names": [
          "PATH"
        ]
      },
      "github_auth": {
        "raw_token_secret_ref": "secret://world_provider_github_copilot_acp/GITHUB_TOKEN",
        "api_token_secret_ref": "secret://world_provider_github_copilot_acp/COPILOT_API_TOKEN",
        "api_token_expiry_secret_ref": "secret://world_provider_github_copilot_acp/COPILOT_API_TOKEN_EXPIRY",
        "device_state_secret_ref": "secret://world_provider_github_copilot_acp/COPILOT_DEVICE_STATE",
        "oauth": {
          "client_id": "Ov23li8tweQw6odWQebz",
          "scope": "read:user",
          "device_code_url": "https://github.com/login/device/code",
          "access_token_url": "https://github.com/login/oauth/access_token",
          "user_agent": "OctopusGitHubCopilotACP/0.1",
          "poll_safety_margin_seconds": 3
        },
        "token_exchange": {
          "url": "https://api.github.com/copilot_internal/v2/token",
          "user_agent": "GitHubCopilotChat/0.26.7",
          "editor_version": "vscode/1.104.1",
          "refresh_margin_seconds": 120
        },
        "request_timeout_ms": 15000,
        "max_response_bytes": 1048576,
        "retryable_statuses": [
          408,
          425,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "context_output_labels": [
        "interface.artifact.output",
        "provider.reasoning",
        "provider.native_tool",
        "provider.usage",
        "operator.approval.request",
        "turn.error",
        "provider.auth.device.code",
        "provider.auth.status"
      ],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "turn.error"
      ],
      "model_catalog": [
        {
          "model": "gpt-5.4",
          "display_name": "GPT-5.4 via GitHub Copilot ACP",
          "default_reasoning_effort": "high",
          "show_in_picker": true
        }
      ]
    },
    "transport": {
      "base_url": "acp+stdio://copilot",
      "wire": "github_copilot_acp",
      "headers": {},
      "request_timeout_ms": 900000,
      "max_response_bytes": 134217728
    }
  }
