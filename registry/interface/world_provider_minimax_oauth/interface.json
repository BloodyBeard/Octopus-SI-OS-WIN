{
  "id": "world_provider_minimax_oauth",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "minimax_oauth"
  ],
  "interface_driver_ref": "anthropic_messages",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 5
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": [
          "MiniMax-M2.7"
        ]
      }
    }
  },
  "interface_driver_config": {
    "private_config": {
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "process_env_names": [],
      "model_hidden_tools": [
        "file.write"
      ],
      "model": "MiniMax-M2.7",
      "oauth": {
        "schema_version": 1,
        "credentials_secret_ref": "secret://world_provider_minimax_oauth/MINIMAX_OAUTH_CREDENTIALS_V1",
        "access_token_cache_secret_ref": "secret://world_provider_minimax_oauth/MINIMAX_OAUTH_ACCESS_TOKEN_CACHE_V1",
        "login_state_secret_ref": "secret://world_provider_minimax_oauth/MINIMAX_OAUTH_LOGIN_STATE_V1",
        "refresh_journal_secret_ref": "secret://world_provider_minimax_oauth/MINIMAX_OAUTH_REFRESH_JOURNAL_V1",
        "refresh_skew_seconds": 60,
        "login_state_ttl_seconds": 900,
        "request_timeout_ms": 15000,
        "max_response_bytes": 1048576,
        "flow": {
          "kind": "minimax_user_code_pkce",
          "authorization_endpoint": "https://api.minimax.io/oauth/code",
          "token_endpoint": "https://api.minimax.io/oauth/token",
          "client_id": "78257093-7e40-4613-99e0-527b14b39113",
          "scope": "group_id profile model.completion",
          "grant_type": "urn:ietf:params:oauth:grant-type:user_code"
        }
      },
      "context_output_labels": [
        "interface.artifact.output",
        "tool.call",
        "provider.tool_results.pending",
        "turn.error",
        "provider.auth.login.action",
        "provider.auth.status",
        "provider.auth.logout.completed",
        "operator.approval.request",
        "operator.elicitation.request"
      ],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "provider.tool_results.pending",
        "turn.error"
      ],
      "model_catalog": [
        {
          "model": "MiniMax-M2.7",
          "display_name": "MiniMax M2.7 (Coding Plan OAuth)",
          "context_window": 204800,
          "input_modalities": ["text"],
          "output_modalities": ["text"],
          "supports_tools": true,
          "supports_reasoning": true,
          "show_in_picker": true
        }
      ],
      "retry_policy": {
        "retryable_http_statuses": [
          408,
          409,
          429,
          500,
          502,
          503,
          504
        ],
        "backoff_ms": [
          500,
          1000,
          2000,
          4000
        ]
      },
      "finish_policy": {
        "successful_stop_reasons": [
          "end_turn",
          "stop_sequence",
          "tool_use",
          "pause_turn",
          "refusal"
        ],
        "nonreplayable_stop_reasons": [
          "max_tokens"
        ]
      },
      "anthropic_messages": {
        "messages_path": "/v1/messages",
        "max_tokens": 32768,
        "stream": true,
        "input_content_types": [
          "text"
        ],
        "response_content_types": [
          "text",
          "thinking",
          "tool_use"
        ],
        "thinking_replay": "drop",
        "request_fields": {
          "thinking": {
            "type": "enabled",
            "budget_tokens": 8192
          }
        }
      }
    },
    "transport": {
      "base_url": "https://api.minimax.io/anthropic",
      "wire": "anthropic_messages",
      "auth_secret_ref": "secret://world_provider_minimax_oauth/MINIMAX_OAUTH_ACCESS_TOKEN_CACHE_V1",
      "auth_header": "Authorization",
      "auth_value_prefix": "Bearer ",
      "headers": {
        "anthropic-version": "2023-06-01"
      },
      "request_timeout_ms": 300000,
      "max_response_bytes": 67108864
    }
  }
}
