{
  "id": "world_text_to_speech",
  "interface_type": "world",
  "role": "service",
  "direction": "bidirectional",
  "source_names": [
    "text_to_speech"
  ],
  "interface_driver_ref": "speech_http",
  "interface_driver_config": {
    "private_config": {
      "model": "gpt-4o-mini-tts",
      "input_request_label": "speech.synthesis.request",
      "voice": "alloy",
      "format": "mp3",
      "text_field": "input",
      "model_field": "model",
      "voice_field": "voice",
      "format_field": "response_format",
      "speed_field": "speed",
      "audio_label": "speech.audio",
      "expected_content_types": [
        "audio/mpeg",
        "audio/mp3",
        "application/octet-stream"
      ],
      "max_text_bytes": 65536,
      "max_audio_bytes": 33554432
    },
    "transport": {
      "base_url": "",
      "base_url_env": "OCTOPUS_TEXT_TO_SPEECH_URL",
      "wire": "speech_json_http",
      "auth_env_key": "OCTOPUS_TEXT_TO_SPEECH_API_KEY",
      "auth_header": "Authorization",
      "auth_value_prefix": "Bearer ",
      "request_timeout_ms": 120000,
      "max_response_bytes": 33554432
    }
  }
}
