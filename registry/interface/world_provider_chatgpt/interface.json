      "native_tool_namespace": {
        "name": "formed_interfaces",
        "description": "Tools admitted through exact Octopus interface grants. Use their advertised methods and schemas. A native Code Mode result is a string: first line compact JSON, then optional image data URLs. Split at the first newline before JSON.parse; forward subsequent image URLs with image(). Tool result JSON carries tool, correlation_id, ok, body and error; interface operations use their declared schema. Inspect the complete returned value in JavaScript and emit selected evidence with text(). Transport failures are errors, never partial success. A model_projection head_tail preview lacks omitted fields. Artifact references do not grant reads, and payload paths are not an access shortcut. Code Mode store/load retain serializable values within the live session; no app/browser SDK is installed here."
      },
      "operator_continuity": {
        "replay_timeout_ms": 30000,
        "approval": {
          "request_label": "operator.approval.request",
          "response_label": "operator.approval.response",
          "approved": {
            "mark": "operator.approval",
            "verifier": "operator_approval"
          },
          "denied": {
            "mark": "operator.input.provided",
            "verifier": "operator_input"
          }
        },
        "elicitation": {
          "request_label": "operator.elicitation.request",
          "response_label": "operator.elicitation.response",
          "provided": {
            "mark": "operator.input.provided",
            "verifier": "operator_input"
          }
        },
        "user_input": {
          "request_label": "operator.user_input.request",
          "response_label": "operator.user_input.response",
          "provided": {
            "mark": "operator.input.provided",
            "verifier": "operator_input"
