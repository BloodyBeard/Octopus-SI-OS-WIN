      "models": {
        "reduce": "intersection",
        "default": [
          "gpt-5.3-codex-spark",
          "gpt-5.4-mini",
          "gpt-5.5",
          "gpt-5.6-luna",
          "gpt-5.6-sol",
          "gpt-5.6-terra",
          "gpt-6-astra"
