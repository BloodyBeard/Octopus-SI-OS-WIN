    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 5
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "web_search_modes": {
        "reduce": "intersection",
        "default": [
          "disabled",
          "cached",
          "indexed",
          "live"
        ]
