{
  "processes": [
    {
      "bin": "python3",
      "io_limits": {
        "max_control_frame_bytes": 1048576,
        "max_stderr_bytes": 262144,
        "max_manifest_bytes": 1048576,
        "max_payload_bytes": 268435456
      },
      "args": [
        {
          "repository_file": "registry/interface/world_email/octopus_python_boot.py"
        },
        {
          "repository_file": "registry/interface/world_email/email_life.py"
        }
      ],
      "private_var_directories": [
        "content-hash-python-runtime"
      ],
      "required_files": [
        "registry/interface/world_email/octopus_python_boot.py",
        "registry/interface/world_email/email_life.py",
        "registry/interface/world_email/email_contract.py",
        "registry/interface/world_email/email_transport.py",
        "registry/interface/world_email/octopus_content_hash.py",
        "registry/interface/world_email/requirements-content-hash.lock"
      ],
      "inherit_env": [
        "EMAIL_ADDRESS",
        "EMAIL_ALLOWED_DOMAINS",
        "EMAIL_ALLOWED_RECIPIENT_DOMAINS",
        "EMAIL_ALLOWED_RECIPIENTS",
        "EMAIL_ALLOWED_USERS",
        "EMAIL_ALLOW_ALL_USERS",
        "EMAIL_ALLOW_ALL_RECIPIENTS",
        "EMAIL_ATTACHMENT_ROOTS",
        "EMAIL_IMAP_HOST",
        "EMAIL_IMAP_PORT",
        "EMAIL_OAUTH_ACCESS_TOKEN",
        "EMAIL_PASSWORD",
        "EMAIL_SMTP_HOST",
        "EMAIL_SMTP_PORT",
        "EMAIL_SIGNATURE",
        "PATH"
      ],
      "authority": {
        "read_root_slots": [],
        "write_root_slots": [],
        "executable_root_slots": [],
        "read_paths": [],
        "write_paths": [],
        "executable_paths": [],
        "executable_commands": [
          "python3"
        ],
        "read_env_paths": [],
        "write_env_paths": [],
        "executable_env_paths": [],
        "executable_env_subpaths": [
          {
            "env": "OCTOPUS_VAR_DIR",
            "relative_path": "content-hash-python-runtime"
          }
        ],
        "optional_read_env_paths": [
          "EMAIL_ATTACHMENT_ROOTS"
        ],
        "allow_network": true,
        "allow_local_ipc": false
      },
      "read_handles": [
        "ledger",
        "blobs",
        "ledger_index"
      ]
    }
  ]
}
