{
  "schema_version": 1,
  "account": {
    "id": "primary",
    "address_env": "EMAIL_ADDRESS",
    "display_name": "Octopus",
    "auth": {
      "mode": "password",
      "password_env": "EMAIL_PASSWORD",
      "oauth_access_token_env": "EMAIL_OAUTH_ACCESS_TOKEN"
    },
    "imap": {
      "host_env": "EMAIL_IMAP_HOST",
      "port_env": "EMAIL_IMAP_PORT",
      "port_default": 993,
      "tls": "implicit",
      "allow_plaintext": false,
      "timeout_ms": 30000,
      "connect_attempt_timeout_ms": 5000,
      "address_family": "auto",
      "send_client_id": true
    },
    "smtp": {
      "host_env": "EMAIL_SMTP_HOST",
      "port_env": "EMAIL_SMTP_PORT",
      "port_default": 587,
      "tls": "starttls",
      "allow_plaintext": false,
      "timeout_ms": 30000,
      "connect_attempt_timeout_ms": 5000,
      "address_family": "auto",
      "save_sent": false
    },
    "mailboxes": {
      "inbox": "INBOX",
      "sent": "Sent",
      "drafts": "Drafts",
      "trash": "Trash",
      "archive": "Archive"
    }
  },
  "intake": {
    "enabled": true,
    "mailboxes": [
      "inbox"
    ],
    "poll_interval_ms": 5000,
    "idle_enabled": true,
    "idle_timeout_ms": 1740000,
    "startup": "catch_up",
    "max_messages_per_poll": 64,
    "dedup_retention": 8192,
    "pending_retention": 2048,
    "mark_seen_after_admission": true,
    "reconnect_backoff_ms": 1000,
    "reconnect_backoff_cap_ms": 60000,
    "emit_health_transitions": true
  },
  "authz": {
    "allow_all_env": "EMAIL_ALLOW_ALL_USERS",
    "allowed_users_env": "EMAIL_ALLOWED_USERS",
    "allowed_domains_env": "EMAIL_ALLOWED_DOMAINS",
    "deny_unmatched": true,
    "reject_self_messages": true,
    "automated_sender_fragments": [
      "noreply",
      "no-reply",
      "no_reply",
      "donotreply",
      "do-not-reply",
      "mailer-daemon",
      "postmaster",
      "bounce",
      "notifications@",
      "automated@",
      "auto-confirm",
      "auto-reply",
      "automailer"
    ],
    "automated_headers": {
      "Auto-Submitted": [
        "auto-generated",
        "auto-replied"
      ],
      "Precedence": [
        "bulk",
        "list",
        "junk"
      ],
      "X-Auto-Response-Suppress": [
        "all",
        "oof",
        "autoreply"
      ]
    },
    "deny_list_unsubscribe": true,
    "pairing": {
      "enabled": false,
      "code_ttl_ms": 86400000,
      "max_pending": 128,
      "subject": "Email access requires approval",
      "body_template": "Your email address is not approved. Give this code to the operator: {code}"
    }
  },
  "authorization_control": {
    "source_interface": "world_email_operator",
    "outbound_interface": "world_email",
    "request_checkpoint": "cp_email_authorization_request",
    "checkpoint": "cp_email_authorization_operator",
    "request_artifact_label": "operator.approval.request",
    "artifact_label": "operator.approval.response",
    "request_mark": "email.authorization.requested",
    "request_verifier": "artifact_exists",
    "mark": "operator.approval",
    "verifier": "operator_approval",
    "request_ttl_ms": 86400000,
    "max_pending_requests": 128,
    "allowed_actions": [
      "authorization.apply"
    ]
  },
  "scopes": {
    "read_mailboxes": [
      "*"
    ],
    "write_mailboxes": [
      "*"
    ],
    "manage_mailboxes": true,
    "allow_all_recipients_env": "EMAIL_ALLOW_ALL_RECIPIENTS",
    "allowed_recipients_env": "EMAIL_ALLOWED_RECIPIENTS",
    "allowed_recipient_domains_env": "EMAIL_ALLOWED_RECIPIENT_DOMAINS",
    "deny_unmatched_recipients": true
  },
  "content": {
    "max_raw_message_bytes": 26214400,
    "max_body_chars": 200000,
    "max_header_chars": 16384,
    "max_headers": 256,
    "max_attachment_bytes": 20971520,
    "max_total_attachment_bytes": 67108864,
    "max_attachments": 32,
    "max_mime_parts": 512,
    "max_inline_data_bytes": 1048576,
    "preserve_raw_message": true,
    "include_html": true,
    "skip_attachments": false
  },
  "composition": {
    "signature_env": "EMAIL_SIGNATURE",
    "signature_separator": "-- ",
    "reply_quote_original": true,
    "forward_include_original": true,
    "allow_custom_headers": true,
    "protected_headers": [
      "bcc",
      "cc",
      "content-transfer-encoding",
      "content-type",
      "date",
      "from",
      "in-reply-to",
      "message-id",
      "mime-version",
      "references",
      "reply-to",
      "subject",
      "to"
    ]
  },
  "outbound": {
    "accepted_labels": [
      "email.action",
      "interface.artifact.output"
    ],
    "allowed_actions": [
      "capabilities.get",
      "health.get",
      "folder.list",
      "folder.status",
      "folder.create",
      "folder.rename",
      "folder.delete",
      "folder.subscribe",
      "folder.unsubscribe",
      "message.list",
      "message.search",
      "message.fetch",
      "message.thread",
      "message.raw",
      "message.send",
      "message.reply",
      "message.reply_all",
      "message.forward",
      "message.copy",
      "message.move",
      "message.delete",
      "message.flags.add",
      "message.flags.remove",
      "message.labels.add",
      "message.labels.remove",
      "draft.create",
      "draft.update",
      "draft.delete",
      "draft.send",
      "attachment.fetch",
      "authorization.list",
      "authorization.request"
    ],
    "max_recipients": 100,
    "max_subject_chars": 998,
    "max_body_chars": 500000,
    "max_message_bytes": 67108864,
    "max_attachment_bytes": 20971520,
    "max_total_attachment_bytes": 67108864,
    "max_attachments": 32,
    "attachment_roots_env": "EMAIL_ATTACHMENT_ROOTS",
    "min_action_interval_ms": 50,
    "retry_max_attempts": 5,
    "retry_backoff_ms": 1000,
    "retry_backoff_cap_ms": 30000,
    "ledger_batch_size": 128
  },
  "driver_ipc": {
    "verdict_timeout_ms": 120000,
    "idle_sleep_ms": 100,
    "max_outbound_payload_bytes": 8388608,
    "max_cached_manifest_bytes": 1048576,
    "ledger_fallback_max_line_bytes": 16777216
  },
  "gateway_run_template": {
    "id": "run_email_gateway",
    "ee": "ee_existence",
    "worker": "system_worker_email",
    "trace": "trace:run_email_gateway",
    "status": "running",
    "interface_state": {},
    "checkpoints": [
      {
        "id": "cp_email_gateway_input",
        "run": "run_email_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "world_email",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "system_worker_email",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-email"
          }
        ],
        "required_verified_artifacts": [],
        "trace": "trace:run_email_gateway:cp_email_gateway_input"
      },
      {
        "id": "cp_email_gateway_output",
        "run": "run_email_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "system_worker_email",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "world_email",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-email"
          }
        ],
        "required_verified_artifacts": [],
        "trace": "trace:run_email_gateway:cp_email_gateway_output"
      },
      {
        "id": "cp_email_authorization_request",
        "run": "run_email_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "world_email",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "world_email_operator",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-email"
          }
        ],
        "required_verified_artifacts": [
          {
            "mark": "email.authorization.requested",
            "artifact_label": "operator.approval.request",
            "verifier": "artifact_exists",
            "params": {}
          }
        ],
        "trace": "trace:run_email_gateway:cp_email_authorization_request"
      },
      {
        "id": "cp_email_authorization_operator",
        "run": "run_email_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "world_email_operator",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "world_email",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-email"
          }
        ],
        "required_verified_artifacts": [
          {
            "mark": "operator.approval",
            "artifact_label": "operator.approval.response",
            "verifier": "operator_approval",
            "params": {}
          }
        ],
        "trace": "trace:run_email_gateway:cp_email_authorization_operator"
      }
    ],
    "active_checkpoints": [
      "cp_email_gateway_input",
      "cp_email_gateway_output",
      "cp_email_authorization_request",
      "cp_email_authorization_operator"
    ]
  }
}
