{
  "id": "world_provider_realtime",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "realtime"
  ],
  "interface_driver_ref": "realtime_webrtc",
  "interface_driver_config": {
    "private_config": {
      "model": "gpt-live-1-codex",
      "protocol": "codex_live",
      "sideband_url": "wss://api.openai.com/v1/live",
      "auth": {
        "mode": "codex_machine",
        "auth_file_env": "OCTOPUS_MACHINE_CODEX_AUTH_FILE"
      },
      "session": {
        "instructions": "You are the live conversational interface for Octopus Home. Keep conversation responsive. Delegate work and corrections to the client; only returned task evidence establishes execution outcomes. Speak selected results and distinguish pending work from confirmed completion. Ending the call does not cancel independent Tasks.",
        "audio": {
          "output": {
            "voice": "maple"
          }
        },
        "delegation": {
          "type": "client"
        }
      },
      "reconnect_attempts": 8,
      "max_transcript_bytes": 1048576,
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "model_hidden_tools": [
        "file.write"
      ],
      "context_output_labels": [
        "realtime.session.context"
      ],
      "session_snapshot_labels": [
        "realtime.session.context"
      ]
    },
    "transport": {
      "base_url": "https://chatgpt.com/backend-api/codex/realtime/calls",
      "wire": "live_webrtc",
      "request_timeout_ms": 30000,
      "max_response_bytes": 1048576,
      "headers": {
        "OpenAI-Alpha": "quicksilver=v2"
      }
    }
  },
  "interface_policy": {
    "variables": {
      "models": {
        "reduce": "intersection",
        "default": [
          "gpt-live-1-codex"
        ]
      }
    }
  }
}
