{
  "processes": [
    {
      "bin": "python3",
      "io_limits": {
        "max_control_frame_bytes": 1048576,
        "max_stderr_bytes": 262144,
        "max_manifest_bytes": 1048576,
        "max_payload_bytes": 268435456
      },
      "args": [
        {
          "repository_file": "registry/interface/world_matrix/matrix_bootstrap.py"
        }
      ],
      "private_var_directories": [
        "python-environment",
        "python-environment-staging"
      ],
      "required_files": [
        "registry/interface/world_matrix/matrix_bootstrap.py",
        "registry/interface/world_matrix/dependency_lock.json",
        "registry/interface/world_matrix/requirements-lock-darwin-arm64-py313.txt",
        "registry/interface/world_matrix/matrix_life.py",
        "registry/interface/world_matrix/matrix_contract.py",
        "registry/interface/world_matrix/matrix_wire.py",
        "registry/interface/world_matrix/matrix_crypto.py",
        "registry/interface/world_matrix/matrix_rendering.py",
        "registry/interface/world_matrix/octopus_content_hash.py",
        "registry/interface/world_matrix/requirements.txt",
        "registry/interface/world_matrix/requirements-e2ee.txt"
      ],
      "inherit_env": [
        "MATRIX_ACCESS_TOKEN",
        "MATRIX_ALLOW_ALL_USERS",
        "MATRIX_ALLOWED_INVITERS",
        "MATRIX_ALLOWED_ROOMS",
        "MATRIX_ALLOWED_SERVERS",
        "MATRIX_ALLOWED_USERS",
        "MATRIX_DEVICE_ID",
        "MATRIX_E2EE_MODE",
        "MATRIX_FREE_RESPONSE_ROOMS",
        "MATRIX_HOME_ROOM",
        "MATRIX_HOMESERVER",
        "MATRIX_IGNORE_USER_PATTERNS",
        "MATRIX_PASSWORD",
        "MATRIX_PROXY",
        "MATRIX_RECOVERY_KEY",
        "MATRIX_USER_ID",
        "OCTOPUS_MATRIX_BINDING_REGISTRY",
        "PATH"
      ],
      "required_env": [
        "MATRIX_HOMESERVER"
      ],
      "authority": {
        "read_root_slots": [
          "registry_interface_root",
          "registry_ee_template_root",
          "registry_tool_root",
          "registry_worker_environment_kind_root",
          "run_records_root",
          "ee_instances_root"
        ],
        "write_root_slots": [],
        "executable_root_slots": [],
        "read_paths": [],
        "write_paths": [],
        "executable_paths": [],
        "executable_commands": [
          "python3"
        ],
        "read_env_paths": [],
        "write_env_paths": [],
        "executable_env_paths": [],
        "executable_env_subpaths": [
          {
            "env": "OCTOPUS_VAR_DIR",
            "relative_path": "python-environment"
          },
          {
            "env": "OCTOPUS_VAR_DIR",
            "relative_path": "python-environment-staging"
          }
        ],
        "allow_network": true,
        "allow_local_ipc": true
      },
      "coordinate_root_slots": [
        "registry_interface_root",
        "registry_ee_template_root",
        "registry_tool_root",
        "registry_worker_environment_kind_root",
        "run_records_root",
        "ee_instances_root"
      ],
      "read_handles": [
        "ledger",
        "blobs",
        "ledger_index"
      ]
    }
  ]
}
