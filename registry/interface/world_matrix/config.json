{
  "schema_version": 1,
  "mode": "gateway",
  "ledger": {
    "max_row_bytes": 1048576
  },
  "transport": {
    "homeserver_env": "MATRIX_HOMESERVER",
    "access_token_env": "MATRIX_ACCESS_TOKEN",
    "user_id_env": "MATRIX_USER_ID",
    "password_env": "MATRIX_PASSWORD",
    "device_id_env": "MATRIX_DEVICE_ID",
    "proxy_env": "MATRIX_PROXY",
    "connect_timeout_ms": 15000,
    "request_timeout_ms": 60000,
    "sync_timeout_ms": 30000,
    "sync_watchdog_ms": 45000,
    "max_response_bytes": 33554432,
    "reconnect_backoff_ms": 500,
    "reconnect_backoff_cap_ms": 30000,
    "rate_limit_max_wait_ms": 120000,
    "safe_retry_limit": 5,
    "user_agent": "Octopus-Matrix/1"
  },
  "authz": {
    "allow_all_users": false,
    "allow_all_users_env": "MATRIX_ALLOW_ALL_USERS",
    "allowed_user_ids": [],
    "allowed_user_ids_env": "MATRIX_ALLOWED_USERS",
    "allowed_room_ids": [],
    "allowed_room_ids_env": "MATRIX_ALLOWED_ROOMS",
    "allowed_server_names": [],
    "allowed_server_names_env": "MATRIX_ALLOWED_SERVERS",
    "allowed_inviter_ids": [],
    "allowed_inviter_ids_env": "MATRIX_ALLOWED_INVITERS",
    "ignored_user_patterns": [
      "^@_"
    ],
    "ignored_user_patterns_env": "MATRIX_IGNORE_USER_PATTERNS",
    "deny_unmatched": true,
    "auto_join_invites": true,
    "allow_public_room_creation": false
  },
  "gating": {
    "respond_in_dms": true,
    "require_mention_in_rooms": true,
    "free_response_room_ids": [],
    "free_response_room_ids_env": "MATRIX_FREE_RESPONSE_ROOMS",
    "thread_require_mention": false,
    "thread_sticky_after_mention": true,
    "thread_sticky_after_bot_reply": true,
    "auto_thread_rooms": true,
    "auto_thread_dms": false,
    "accept_notices": false,
    "accept_edits": true,
    "accept_redactions": true,
    "accept_reactions": true,
    "accept_membership": true,
    "accept_receipts": true,
    "accept_typing": true,
    "accept_presence": true,
    "allow_room_mentions": false
  },
  "sync": {
    "initial_backfill": "retain_raw",
    "max_pending_events": 20000,
    "pending_retry_ms": 500,
    "dedup_retention": 50000,
    "raw_sync_retention": 256,
    "text_batch_delay_ms": 600,
    "text_batch_split_delay_ms": 2000,
    "text_batch_split_threshold": 3900
  },
  "routing": {
    "binding_registry_path_env": "OCTOPUS_MATRIX_BINDING_REGISTRY",
    "private_scope": "all",
    "unbound_policy": "retain",
    "binding_authoring_mode": "automatic",
    "ipc_listen": "127.0.0.1",
    "ipc_port": 32742,
    "ipc_max_frame_bytes": 201326592
  },
  "crypto": {
    "mode": "optional",
    "mode_env": "MATRIX_E2EE_MODE",
    "store_subdir": "crypto",
    "minimum_device_trust": "unverified",
    "recovery_key_env": "MATRIX_RECOVERY_KEY",
    "generated_recovery_key_file": "generated-recovery-key.txt",
    "encrypt_media": true,
    "require_cross_signing": false,
    "max_undecrypted_events": 1000
  },
  "media": {
    "max_download_bytes": 134217728,
    "max_upload_bytes": 134217728,
    "text_preview_bytes": 102400,
    "inline_text_extensions": [
      ".txt",
      ".md",
      ".json",
      ".jsonl",
      ".csv",
      ".tsv",
      ".yaml",
      ".yml",
      ".toml",
      ".xml",
      ".html",
      ".css",
      ".js",
      ".ts",
      ".py",
      ".rs",
      ".go",
      ".java",
      ".sh",
      ".log"
    ]
  },
  "outbound": {
    "reply_labels": [
      "interface.artifact.output",
      "matrix.operation"
    ],
    "stream_labels": [
      "agent.message.delta"
    ],
    "error_labels": [
      "turn.error"
    ],
    "telemetry_labels": [
      "goal.status",
      "hook.catalog",
      "hook.result",
      "turn.exec.command",
      "turn.plan.update",
      "turn.reasoning",
      "turn.token_usage",
      "turn.web_search"
    ],
    "max_message_chars": 4000,
    "max_manifest_bytes": 1048576,
    "max_payload_bytes": 8388608,
    "stream_edit_interval_ms": 1000,
    "home_room_env": "MATRIX_HOME_ROOM",
    "reactions": {
      "enabled": true,
      "processing": "👀",
      "success": "✅",
      "failure": "❌"
    },
    "allowed_operations": [
      "account.data.get",
      "device.keys.query",
      "device.verify",
      "location.send",
      "media.send",
      "message.edit",
      "message.redact",
      "message.send",
      "presence.set",
      "reaction.redact",
      "reaction.send",
      "receipt.read",
      "room.ban",
      "room.create",
      "room.history",
      "room.invite",
      "room.join",
      "room.kick",
      "room.leave",
      "room.members",
      "room.name.set",
      "room.state.get",
      "room.topic.set",
      "room.unban",
      "typing.clear",
      "typing.set"
    ],
    "retry_safe_operations": [
      "account.data.get",
      "device.keys.query",
      "location.send",
      "message.edit",
      "message.redact",
      "message.send",
      "reaction.redact",
      "reaction.send",
      "receipt.read",
      "room.history",
      "room.members",
      "room.state.get",
      "typing.clear",
      "typing.set"
    ],
    "binding_allowed_operations": [
      "location.send",
      "media.send",
      "message.edit",
      "message.redact",
      "message.send",
      "reaction.redact",
      "reaction.send",
      "receipt.read",
      "room.history",
      "room.members",
      "room.state.get",
      "typing.clear",
      "typing.set"
    ]
  },
  "private_run": {
    "ee_template_owner": "operator_interaction",
    "parent_ee": "ee_existence",
    "model": "gpt-5.5",
    "reasoning_effort": "xhigh",
    "role_artifacts": [
      "artifact-worker-role-matrix"
    ],
    "interface_owners": {
      "matrix": "world_matrix",
      "provider": "world_provider_codex",
      "interface_authoring": "system_interface_authoring",
      "worker": "system_worker_matrix",
      "worker_environment": "system_room_matrix_gateway",
      "operator": "world_operator_chat"
    },
    "id_prefixes": {
      "run": "run_matrix_",
      "ee": "ee_matrix_",
      "ee_template": "operator_interaction_matrix_",
      "matrix": "world_matrix_",
      "provider": "world_provider_codex_matrix_",
      "interface_authoring": "system_interface_authoring_matrix_",
      "worker": "system_worker_matrix_",
      "worker_environment": "system_room_matrix_",
      "tool": "file.write.matrix_"
    },
    "file_write_tool": "file.write.matrix_gateway",
    "file_write_label": "tool.call",
    "file_write_result_label": "file.write.result",
    "worker_environment_kind": "system_room",
    "file_write_mark_outcome": "tool.call.allowed",
    "provider_context_output_labels": [
      "interface.artifact.output",
      "tool.call",
      "turn.error",
      "operator.approval.request",
      "operator.elicitation.request"
    ],
    "result_timeout_ms": 30000,
    "authoring_retry_attempts": 3
  },
  "binding": null,
  "gateway_run_template": {
    "id": "run_matrix_gateway",
    "ee": "ee_existence",
    "worker": "system_worker_matrix",
    "trace": "trace:run_matrix_gateway",
    "status": "running",
    "interface_state": {},
    "checkpoints": [
      {
        "id": "cp_matrix_gateway_authoring_call",
        "run": "run_matrix_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "world_matrix",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "system_room_matrix_gateway",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-matrix"
          }
        ],
        "required_verified_artifacts": [],
        "trace": "trace:run_matrix_gateway:cp_matrix_gateway_authoring_call"
      },
      {
        "id": "cp_matrix_gateway_authoring_result",
        "run": "run_matrix_gateway",
        "epoch": 0,
        "interface_binding": {
          "interface": "system_room_matrix_gateway",
          "config": {
            "artifact_policy": {
              "mode": "all"
            }
          }
        },
        "outbound_interface_bindings": [
          {
            "interface": "world_matrix",
            "config": {
              "artifact_policy": {
                "mode": "all"
              }
            }
          }
        ],
        "artifact_bindings": [
          {
            "id": "artifact-worker-role-matrix"
          }
        ],
        "required_verified_artifacts": [],
        "trace": "trace:run_matrix_gateway:cp_matrix_gateway_authoring_result"
      }
    ],
    "active_checkpoints": [
      "cp_matrix_gateway_authoring_call",
      "cp_matrix_gateway_authoring_result"
    ]
  }
}
