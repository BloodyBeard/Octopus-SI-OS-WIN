{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface",
    "poll_interval_ms",
    "read_roots",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "interface": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "poll_interval_ms": {
      "type": "integer",
      "minimum": 50,
      "maximum": 3600000
    },
    "read_roots": {
      "description": "Explicit existing canonical directories granting read scope. No roots are inferred from selected files.",
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/",
        "maxLength": 4096
      }
    },
    "files": {
      "description": "Only these selected files become artifacts; each must be below a declared read root and may be absent at startup.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "label",
          "max_bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 4096
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144
          }
        }
      }
    }
  }
}
