{
  "id": "world_provider_azure_foundry_anthropic_api_key",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "provider.azure_foundry.anthropic.api_key"
  ],
  "interface_driver_ref": "codex_app_server",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 1
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": []
      }
    }
  },
  "interface_driver_config": {
    "private_config": {
      "instruction_artifacts": [],
      "worker_instruction_artifacts": [],
      "model_tool_names": {},
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "process_env_names": [
        "AZURE_FOUNDRY_ANTHROPIC_BASE_URL",
        "AZURE_FOUNDRY_ANTHROPIC_MODEL"
      ],
      "model_hidden_tools": [
        "file.write"
      ],
      "model_env": "AZURE_FOUNDRY_ANTHROPIC_MODEL",
      "context_output_labels": ["interface.artifact.output", "interface.context.updated", "tool.call", "turn.control.acknowledged", "turn.interrupted.result", "turn.context.compaction", "turn.error", "operator.approval.request", "operator.elicitation.request", "turn.agent_message", "turn.reasoning", "turn.plan.update"],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "turn.interrupted.result",
        "turn.error"
      ],
      "retry_policy": {
        "retryable_http_statuses": [
          408,
          409,
          425,
          429,
          500,
          502,
          503,
          504
        ],
        "backoff_ms": [
          1000
        ]
      },
      "finish_policy": {
        "successful_stop_reasons": [
          "end_turn",
          "stop_sequence",
          "tool_use",
          "pause_turn",
          "refusal"
        ],
        "nonreplayable_stop_reasons": []
      },
      "anthropic_messages": {
        "messages_path": "/v1/messages",
        "max_tokens": 64000,
        "stream": true,
        "input_content_types": [
          "text",
          "image"
        ],
        "response_content_types": [
          "text",
          "thinking",
          "redacted_thinking",
          "tool_use"
        ],
        "thinking_replay": "verbatim",
        "request_fields": {
          "thinking": {
            "type": "adaptive"
          },
          "output_config": {
            "effort": "medium"
          }
        }
      },
      "native_tool_namespace": {
        "name": "formed_interfaces",
        "description": "Tools admitted through the formed Octopus interface grant."
      },
      "operator_continuity": {
        "replay_timeout_ms": 30000,
        "approval": {
          "request_label": "operator.approval.request",
          "response_label": "operator.approval.response",
          "approved": {
            "mark": "operator.approval",
            "verifier": "operator_approval"
          },
          "denied": {
            "mark": "operator.input.provided",
            "verifier": "operator_input"
          }
        },
        "elicitation": {
          "request_label": "operator.elicitation.request",
          "response_label": "operator.elicitation.response",
          "provided": {
            "mark": "operator.input.provided",
            "verifier": "operator_input"
          }
        },
        "user_input": {
          "request_label": "operator.user_input.request",
          "response_label": "operator.user_input.response",
          "provided": {
            "mark": "operator.input.provided",
            "verifier": "operator_input"
          }
        }
      },
      "model_catalog_operation": {
        "request_label": "provider.models.list",
        "output_label": "provider.models.catalog",
        "default_limit": 100,
        "max_limit": 100,
        "include_hidden": false
      },
      "private_thread_cold_start": "resume_compatible",
      "model_result_projection": {
        "max_tokens": 10000
      },
      "client_projection_output_labels": [
        "interface.artifact.output",
        "interface.context.updated",
        "tool.call",
        "turn.error",
        "turn.control.acknowledged",
        "turn.control.failed",
        "turn.interrupted.result",
        "operator.approval.request",
        "operator.elicitation.request",
        "operator.user_input.request",
        "provider.models.catalog",
        "provider.operation.error",
        "provider.account.login.completed",
        "provider.account.updated",
        "provider.account.rate_limits.updated",
        "provider.account.login.started",
        "provider.account.login.cancelled",
        "provider.account.login.status",
        "provider.account.logged_out",
        "provider.account.snapshot",
        "provider.account.rate_limits",
        "provider.account.rate_limit_reset.consumed",
        "provider.account.usage",
        "provider.account.workspace_messages",
        "provider.capabilities",
        "agent.message.delta",
        "turn.agent_message",
        "turn.reasoning",
        "turn.reasoning.delta",
        "turn.plan.update",
        "turn.plan.delta",
        "turn.exec.command",
        "turn.exec.output_delta",
        "turn.exec.terminal_interaction",
        "turn.file.change",
        "turn.file.change_delta",
        "turn.diff.updated",
        "turn.web_search",
        "lifecycle.event",
        "hook.catalog",
        "hook.catalog.error",
        "hook.result",
        "turn.hook.prompt",
        "turn.mcp.tool_call",
        "turn.mcp.progress",
        "turn.mcp.status",
        "turn.dynamic_tool_call",
        "turn.collaboration",
        "turn.subagent.activity",
        "turn.image.view",
        "turn.sleep",
        "turn.image.generation",
        "turn.review.entered",
        "turn.review.exited",
        "turn.context.compaction",
        "turn.started",
        "turn.completed",
        "turn.model.rerouted",
        "turn.model.verification",
        "turn.auth_recovery.started",
        "turn.auth_recovery.completed",
        "turn.warning",
        "turn.auto_review.started",
        "turn.auto_review.completed",
        "turn.operator_request.resolved",
        "goal.status",
        "account.rate_limits"
      ],
      "opencodex": {
        "schema_version": 1,
        "adapter": "anthropic",
        "credential_owner_interface": "world_provider_azure_foundry_anthropic_api_key",
        "allow_private_network": false,
        "cache_retention": "short",
        "options": {
          "auth_mode": "key",
          "api_key_transport": "x-api-key"
        },
        "limits": {
          "max_request_bytes": 33554432,
          "max_translated_call_bytes": 2097152,
          "max_translated_turn_bytes": 33554432
        }
      }
    },
    "transport": {
      "base_url": "",
      "base_url_env": "AZURE_FOUNDRY_ANTHROPIC_BASE_URL",
      "wire": "anthropic_messages",
      "auth_secret_ref": "secret://world_provider_azure_foundry_anthropic_api_key/AZURE_FOUNDRY_API_KEY",
      "auth_header": "x-api-key",
      "auth_value_prefix": "",
      "headers": {
        "anthropic-version": "2023-06-01"
      },
      "request_timeout_ms": 600000,
      "max_response_bytes": 134217728
    },
    "residual_ambient": {
      "transport": "codex_app_server_cli",
      "status": "declared_residual_not_octopus_authority",
      "boundary": "Codex app-server has no raw model endpoint. Octopus suppresses known path-loaded ambient and declares the remaining interface-assembled frame as ledger evidence.",
      "spawn": {
        "subcommand": "app-server",
        "extra_argv": [],
        "isolation_overrides": [
          "project_doc_max_bytes=0",
          "features.shell_tool=false",
          "features.unified_exec=false",
          "features.shell_snapshot=false",
          "features.hooks=false",
          "features.multi_agent=false",
          "features.apps=false",
          "features.plugins=false",
          "features.memories=false",
          "features.tool_suggest=false",
          "features.in_app_browser=false",
          "features.browser_use=false",
          "features.browser_use_full_cdp_access=false",
          "features.browser_use_external=false",
          "features.computer_use=false",
          "features.remote_plugin=false",
          "features.plugin_sharing=false",
          "features.skill_mcp_dependency_install=false",
          "features.skill_search=false",
          "features.mentions_v2=false",
          "features.guardian_approval=false",
          "features.tool_call_mcp_elicitation=false",
          "features.auth_elicitation=false",
          "features.personality=false",
          "features.workspace_dependencies=false",
          "features.code_mode_host=true",
          "personality=none",
          "sandbox_mode=read-only",
          "web_search=disabled",
          "skills.include_instructions=false",
          "include_apps_instructions=false",
          "features.goals=false",
          "features.image_generation=false",
          "features.tool_search=false",
          "features.search_tool=false",
          "features.request_permissions_tool=false",
          "features.sleep_tool=false",
          "features.current_time_reminder=false",
          "tools.experimental_request_user_input.enabled=false"
        ],
        "home_env": "CODEX_HOME",
        "isolated_cwd": "codex-cwd",
        "connect_on_ready": false,
        "idle_disconnect_ms": 300000
      },
      "residual_sources": [
        {
          "name": "codex_core_system_developer_tool_policy",
          "suppressible_by_current_config": false,
          "octopus_authority": false
        },
        {
          "name": "codex_env_context_input_item",
          "fields": [
            "cwd",
            "shell",
            "current_date",
            "timezone",
            "filesystem",
            "permission_profile"
          ],
          "suppressible_by_current_config": false,
          "octopus_authority": false
        },
        {
          "name": "codex_update_plan_tool_spec",
          "suppressible_by_current_config": false,
          "octopus_authority": false,
          "execution_boundary": "interface handler fails closed on server-initiated native tool requests; Octopus tools execute only as artifacts through granted worker-environment interfaces"
        }
      ],
      "suppressed_sources": [
        "CODEX_HOME/AGENTS.md via curated CODEX_HOME",
        "repo AGENTS.md/CLAUDE.md via project_doc_max_bytes=0 and repo-free cwd",
        "non-Octopus product ambient instruction sources via explicit interface config pins",
        "shell/exec/apply_patch/view_image via empty per-thread environments"
      ]
    }
  }
}
