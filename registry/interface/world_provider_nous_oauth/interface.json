{
  "id": "world_provider_nous_oauth",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "nous_oauth"
  ],
  "interface_driver_config": {
    "private_config": {
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "process_env_names": [],
      "model_hidden_tools": [
        "file.write"
      ],
      "model": "hermes-3-70b",
      "nous_oauth": {
        "schema_version": 1,
        "credentials_secret_ref": "secret://world_provider_nous_oauth/NOUS_OAUTH_CREDENTIALS",
        "invoke_token_cache_secret_ref": "secret://world_provider_nous_oauth/NOUS_INVOKE_TOKEN_CACHE",
        "device_state_secret_ref": "secret://world_provider_nous_oauth/NOUS_DEVICE_STATE",
        "refresh_journal_secret_ref": "secret://world_provider_nous_oauth/NOUS_OAUTH_REFRESH_JOURNAL",
        "device_code_endpoint": "https://portal.nousresearch.com/api/oauth/device/code",
        "token_endpoint": "https://portal.nousresearch.com/api/oauth/token",
        "client_id": "hermes-cli",
        "scope": "inference:invoke",
        "refresh_skew_seconds": 120,
        "poll_interval_cap_seconds": 1,
        "slow_down_increment_seconds": 1,
        "slow_down_cap_seconds": 30,
        "request_timeout_ms": 15000,
        "max_response_bytes": 1048576
      },
      "openai_compatible_transport_defaults": {
        "request_timeout_ms": 120000,
        "max_response_bytes": 8388608
      },
      "openai_compatible": {
        "model_catalog": {
          "request_label": "provider.models.list",
          "output_label": "provider.models.catalog",
          "path": "models"
        },
        "request": {
          "path": "chat/completions",
          "stream": true,
          "require_done": true,
          "message_content": "string",
          "retryable_statuses": [
            408,
            425,
            429,
            500,
            502,
            503,
            504
          ],
          "body": {
            "tags": [
              "product=octopus",
              "client=octopus-interface-v1"
            ]
          },
          "artifact_body": {
            "field": "provider_request",
            "allowed_keys": [
              "max_tokens",
              "reasoning",
              "response_format",
              "temperature",
              "top_p"
            ]
          }
        },
        "response": {
          "reasoning_fields": [
            "reasoning",
            "reasoning_content"
          ],
          "reasoning_detail_fields": [
            "reasoning_details"
          ],
          "successful_finish_reasons": [
            "stop",
            "tool_calls"
          ],
          "nonreplayable_finish_reasons": [
            "length"
          ]
        },
        "input_modalities": [
          "text"
        ],
        "header_env": {}
      },
      "openai_compatible_retry": {
        "backoff_ms": [
          1000,
          2000,
          4000,
          8000
        ]
      },
      "context_output_labels": [
        "interface.artifact.output",
        "tool.call",
        "provider.tool_results.pending",
        "turn.error",
        "provider.auth.device.code",
        "provider.auth.status",
        "operator.approval.request",
        "operator.elicitation.request"
      ],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "provider.tool_results.pending",
        "turn.error"
      ],
      "model_catalog": [
        {
          "model": "hermes-3-70b",
          "display_name": "Hermes 3 70B (Nous Portal OAuth)",
          "show_in_picker": true
        }
      ]
    },
    "transport": {
      "base_url": "https://inference-api.nousresearch.com/v1",
      "wire": "openai_chat_completions",
      "auth_secret_ref": "secret://world_provider_nous_oauth/NOUS_INVOKE_TOKEN_CACHE",
      "auth_header": "Authorization",
      "auth_value_prefix": "Bearer ",
      "headers": {},
      "request_timeout_ms": 180000,
      "max_response_bytes": 8388608
    }
  },
  "interface_driver_ref": "openai_compatible",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 5
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": [
          "hermes-3-70b"
        ]
      }
    }
  }
}
