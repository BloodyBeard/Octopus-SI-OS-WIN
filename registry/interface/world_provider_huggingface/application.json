{
  "schema_version": 3,
  "id": "world_provider_huggingface",
  "name": "Hugging Face",
  "description": "Models on Hugging Face Inference Providers through a Hugging Face token.",
  "category": "provider",
  "developer": "Hugging Face",
  "version": "1.0.0",
  "icon": "sparkles",
  "logo": "application-logo.svg",
  "interfaces": [
    "world_provider_huggingface"
  ],
  "setup": {
    "fields": [
      {
        "interface": "world_provider_huggingface",
        "pointer": "/interface_driver_config/transport/auth_env_key",
        "label": "Hugging Face token",
        "kind": "secret",
        "required": true
      },
      {
        "interface": "world_provider_huggingface",
        "pointer": "/interface_driver_config/private_config/opencodex/model_env",
        "label": "Model id, for example openai/gpt-oss-120b",
        "kind": "text",
        "required": true
      }
    ]
  }
}
