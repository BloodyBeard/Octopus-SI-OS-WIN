{
  "id": "world_speech_to_text",
  "interface_type": "world",
  "role": "service",
  "direction": "bidirectional",
  "source_names": [
    "speech_to_text"
  ],
  "interface_driver_ref": "speech_http",
  "interface_driver_config": {
    "private_config": {
      "model": "gpt-4o-transcribe",
      "input_audio_label": "microphone.audio",
      "input_request_label": "speech.transcription.request",
      "file_field": "file",
      "model_field": "model",
      "language_field": "language",
      "prompt_field": "prompt",
      "response_format_field": "response_format",
      "response_format": "json",
      "transcript_path": "text",
      "language_path": "language",
      "duration_path": "duration",
      "transcript_label": "speech.transcript",
      "max_audio_bytes": 33554432,
      "max_transcript_bytes": 1048576
    },
    "transport": {
      "base_url": "https://api.openai.com/v1/audio/transcriptions",
      "base_url_env": "OCTOPUS_SPEECH_TO_TEXT_URL",
      "wire": "speech_multipart_http",
      "auth_env_key": "OCTOPUS_SPEECH_TO_TEXT_API_KEY",
      "auth_secret_ref": "secret://world_speech_to_text/OPENAI_API_KEY",
      "auth_header": "Authorization",
      "auth_value_prefix": "Bearer ",
      "request_timeout_ms": 120000,
      "max_response_bytes": 4194304
    }
  }
}
