{
  "id": "world_provider_anthropic_oauth",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "anthropic_oauth"
  ],
  "interface_driver_ref": "anthropic_messages",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 5
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": [
          "claude-sonnet-4-6"
        ]
      }
    }
  },
  "interface_driver_config": {
    "private_config": {
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "process_env_names": [],
      "model_hidden_tools": [
        "file.write"
      ],
      "model": "claude-sonnet-4-6",
      "oauth": {
        "schema_version": 1,
        "credentials_secret_ref": "secret://world_provider_anthropic_oauth/ANTHROPIC_OAUTH_CREDENTIALS_V1",
        "access_token_cache_secret_ref": "secret://world_provider_anthropic_oauth/ANTHROPIC_OAUTH_ACCESS_TOKEN_CACHE_V1",
        "login_state_secret_ref": "secret://world_provider_anthropic_oauth/ANTHROPIC_OAUTH_LOGIN_STATE_V1",
        "refresh_journal_secret_ref": "secret://world_provider_anthropic_oauth/ANTHROPIC_OAUTH_REFRESH_JOURNAL_V1",
        "refresh_skew_seconds": 120,
        "login_state_ttl_seconds": 900,
        "request_timeout_ms": 20000,
        "max_response_bytes": 1048576,
        "flow": {
          "kind": "anthropic_manual_pkce",
          "authorization_endpoint": "https://claude.ai/oauth/authorize",
          "token_endpoint": "https://platform.claude.com/v1/oauth/token",
          "client_id": "9d1c250a-e61b-44d9-88ed-5944d1962f5e",
          "redirect_uri": "https://console.anthropic.com/oauth/code/callback",
          "scope": "org:create_api_key user:profile user:inference",
          "user_agent": "claude-cli/2.1.74 (external, cli)"
        }
      },
      "context_output_labels": [
        "interface.artifact.output",
        "tool.call",
        "provider.tool_results.pending",
        "turn.error",
        "provider.auth.login.action",
        "provider.auth.status",
        "provider.auth.logout.completed",
        "operator.approval.request",
        "operator.elicitation.request"
      ],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "provider.tool_results.pending",
        "turn.error"
      ],
      "model_catalog": [
        {
          "model": "claude-sonnet-4-6",
          "display_name": "Claude Sonnet 4.6 (Claude OAuth)",
          "context_window": 1000000,
          "max_output_tokens": 64000,
          "input_modalities": ["text", "image", "document"],
          "output_modalities": ["text"],
          "supports_tools": true,
          "supports_reasoning": true,
          "default_reasoning_effort": "medium",
          "supported_reasoning_efforts": [
            {"effort": "low", "description": "Low reasoning"},
            {"effort": "medium", "description": "Medium reasoning"},
            {"effort": "high", "description": "High reasoning"},
            {"effort": "max", "description": "Maximum reasoning"}
          ],
          "show_in_picker": true
        }
      ],
      "retry_policy": {
        "retryable_http_statuses": [
          408,
          409,
          429,
          500,
          502,
          503,
          504
        ],
        "backoff_ms": [
          500,
          1000,
          2000,
          4000
        ]
      },
      "finish_policy": {
        "successful_stop_reasons": [
          "end_turn",
          "stop_sequence",
          "tool_use",
          "pause_turn",
          "refusal"
        ],
        "nonreplayable_stop_reasons": [
          "max_tokens"
        ]
      },
      "anthropic_messages": {
        "messages_path": "/v1/messages",
        "models_path": "/v1/models",
        "max_tokens": 64000,
        "stream": true,
        "input_content_types": [
          "text",
          "image",
          "document"
        ],
        "response_content_types": [
          "text",
          "thinking",
          "redacted_thinking",
          "tool_use"
        ],
        "thinking_replay": "verbatim",
        "system_prefix": "You are Claude Code, Anthropic's official CLI for Claude.",
        "tool_name_prefix": "mcp__",
        "request_fields": {
          "thinking": {
            "type": "adaptive",
            "display": "summarized"
          },
          "output_config": {
            "effort": "medium"
          }
        }
      }
    },
    "transport": {
      "base_url": "https://api.anthropic.com",
      "wire": "anthropic_messages",
      "auth_secret_ref": "secret://world_provider_anthropic_oauth/ANTHROPIC_OAUTH_ACCESS_TOKEN_CACHE_V1",
      "auth_header": "Authorization",
      "auth_value_prefix": "Bearer ",
      "headers": {
        "anthropic-version": "2023-06-01",
        "anthropic-beta": "interleaved-thinking-2025-05-14,fine-grained-tool-streaming-2025-05-14,claude-code-20250219,oauth-2025-04-20",
        "user-agent": "claude-cli/2.1.74 (external, cli)",
        "x-app": "cli"
      },
      "request_timeout_ms": 300000,
      "max_response_bytes": 67108864
    }
  }
}
