{
  "id": "world_provider_qwen_oauth",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "qwen_oauth"
  ],
  "interface_driver_config": {
    "private_config": {
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "process_env_names": [],
      "model_hidden_tools": [
        "file.write"
      ],
      "model": "qwen3-vl-plus",
      "qwen_oauth": {
        "schema_version": 1,
        "credentials_secret_ref": "secret://world_provider_qwen_oauth/QWEN_OAUTH_CREDENTIALS",
        "access_token_cache_secret_ref": "secret://world_provider_qwen_oauth/QWEN_OAUTH_ACCESS_TOKEN_CACHE",
        "refresh_journal_secret_ref": "secret://world_provider_qwen_oauth/QWEN_OAUTH_REFRESH_JOURNAL",
        "token_endpoint": "https://chat.qwen.ai/api/v1/oauth2/token",
        "client_id": "f0304373b74a44d2b584a3fb70ca9e56",
        "refresh_skew_seconds": 120,
        "request_timeout_ms": 20000,
        "max_response_bytes": 1048576,
        "qwen_code_version": "0.14.1"
      },
      "openai_compatible_transport_defaults": {
        "request_timeout_ms": 120000,
        "max_response_bytes": 8388608
      },
      "openai_compatible": {
        "model_catalog": {
          "request_label": "provider.models.list",
          "output_label": "provider.models.catalog",
          "path": "models"
        },
        "request": {
          "path": "chat/completions",
          "stream": true,
          "require_done": true,
          "message_content": "parts",
          "system_content_part_fields": {
            "cache_control": {
              "type": "ephemeral"
            }
          },
          "retryable_statuses": [
            408,
            425,
            429,
            500,
            502,
            503,
            504
          ],
          "body": {
            "max_tokens": 65536,
            "vl_high_resolution_images": true,
            "parallel_tool_calls": true,
            "stream_options": {
              "include_usage": true
            }
          },
          "artifact_body": {
            "field": "provider_request",
            "allowed_keys": [
              "enable_thinking",
              "metadata",
              "temperature",
              "thinking_budget",
              "top_p"
            ]
          }
        },
        "response": {
          "reasoning_fields": [
            "reasoning",
            "reasoning_content"
          ],
          "reasoning_detail_fields": [
            "reasoning_details"
          ],
          "successful_finish_reasons": [
            "stop",
            "tool_calls"
          ],
          "nonreplayable_finish_reasons": [
            "length"
          ]
        },
        "input_modalities": [
          "text",
          "image_url"
        ],
        "header_env": {}
      },
      "openai_compatible_retry": {
        "backoff_ms": [
          1000,
          2000,
          4000,
          8000
        ]
      },
      "context_output_labels": [
        "interface.artifact.output",
        "tool.call",
        "provider.tool_results.pending",
        "turn.error",
        "operator.approval.request",
        "operator.elicitation.request"
      ],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "provider.tool_results.pending",
        "turn.error"
      ],
      "model_catalog": [
        {
          "model": "qwen3-vl-plus",
          "display_name": "Qwen 3 VL Plus (Portal OAuth)",
          "show_in_picker": true
        }
      ]
    },
    "transport": {
      "base_url": "https://portal.qwen.ai/v1",
      "wire": "openai_chat_completions",
      "auth_secret_ref": "secret://world_provider_qwen_oauth/QWEN_OAUTH_ACCESS_TOKEN_CACHE",
      "auth_header": "Authorization",
      "auth_value_prefix": "Bearer ",
      "headers": {},
      "request_timeout_ms": 300000,
      "max_response_bytes": 16777216
    }
  },
  "interface_driver_ref": "openai_compatible",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 5
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": [
          "qwen3-vl-plus"
        ]
      }
    }
  }
}
