{
  "id": "world_provider_github_copilot",
  "interface_type": "world",
  "role": "provider",
  "direction": "bidirectional",
  "source_names": [
    "provider.github_copilot"
  ],
  "interface_driver_ref": "github_copilot_responses",
  "interface_policy": {
    "variables": {
      "max_attempts": {
        "reduce": "min",
        "default": 5
      },
      "max_in_flight": {
        "reduce": "min",
        "default": 1
      },
      "models": {
        "reduce": "intersection",
        "default": [
          "gpt-5.4"
        ]
      }
    }
  },
  "interface_driver_config": {
    "supported_reasoning_efforts": [
      "low",
      "medium",
      "high"
    ],
    "private_config": {
      "run_authoring_profile": {
        "file_write_tool": "file.write",
        "file_write_label": "tool.call",
        "file_write_result_label": "file.write.result",
        "result_timeout_ms": 30000
      },
      "process_env_names": [],
      "model_hidden_tools": [
        "file.write"
      ],
      "model": "gpt-5.4",
      "base_url_source": "descriptor",
      "auth_source": "secret",
      "github_copilot": {
        "model": "gpt-5.4",
        "catalog_filter": {
          "required_endpoint": "/responses",
          "required_capability_type": "chat"
        },
        "retry_backoff_ms": [
          1000,
          2000,
          4000,
          8000
        ]
      },
      "github_auth": {
        "raw_token_secret_ref": "secret://world_provider_github_copilot/GITHUB_TOKEN",
        "api_token_secret_ref": "secret://world_provider_github_copilot/COPILOT_API_TOKEN",
        "api_token_expiry_secret_ref": "secret://world_provider_github_copilot/COPILOT_API_TOKEN_EXPIRY",
        "device_state_secret_ref": "secret://world_provider_github_copilot/COPILOT_DEVICE_STATE",
        "oauth": {
          "client_id": "Ov23li8tweQw6odWQebz",
          "scope": "read:user",
          "device_code_url": "https://github.com/login/device/code",
          "access_token_url": "https://github.com/login/oauth/access_token",
          "user_agent": "OctopusGitHubCopilot/0.1",
          "poll_safety_margin_seconds": 3
        },
        "token_exchange": {
          "url": "https://api.github.com/copilot_internal/v2/token",
          "user_agent": "GitHubCopilotChat/0.26.7",
          "editor_version": "vscode/1.104.1",
          "refresh_margin_seconds": 120
        },
        "request_timeout_ms": 15000,
        "max_response_bytes": 1048576,
        "retryable_statuses": [
          408,
          425,
          429,
          500,
          502,
          503,
          504
        ]
      },
      "context_output_labels": [
        "interface.artifact.output",
        "provider.reasoning",
        "provider.native_tool",
        "provider.tool_results.pending",
        "provider.usage",
        "tool.call",
        "turn.error",
        "provider.auth.device.code",
        "provider.auth.status"
      ],
      "session_snapshot_labels": [
        "interface.artifact.output",
        "provider.tool_results.pending",
        "turn.error"
      ],
      "model_catalog": [
        {
          "model": "gpt-5.4",
          "display_name": "GPT-5.4 via GitHub Copilot",
          "default_reasoning_effort": "high",
          "supported_reasoning_efforts": [
            {
              "effort": "low",
              "description": "Low reasoning"
            },
            {
              "effort": "medium",
              "description": "Medium reasoning"
            },
            {
              "effort": "high",
              "description": "High reasoning"
            }
          ],
          "input_modalities": ["text"],
          "output_modalities": ["text"],
          "supports_tools": true,
          "supports_reasoning": true,
          "supports_parallel_tool_calls": true,
          "show_in_picker": true
        }
      ],
      "responses_api": {
        "operation": {
          "method": "post",
          "path": "/responses",
          "response_mode": "sse",
          "sequence_numbers": "required_monotonic"
        },
        "request_fields": {
          "store": false,
          "reasoning": {
            "effort": "high",
            "summary": "auto"
          },
          "include": [
            "reasoning.encrypted_content"
          ]
        },
        "cache": {
          "mode": "static_prefix_blake3",
          "field": "prompt_cache_key",
          "prefix": "pck_",
          "digest_characters": 24
        },
        "retry": {
          "backoff_ms": 1000,
          "max_backoff_ms": 8000,
          "http_statuses": [
            408,
            409,
            425,
            429,
            500,
            502,
            503,
            504
          ]
        },
        "model_catalog": {
          "path": "/models",
          "request_label": "provider.models.list",
          "output_label": "provider.models.catalog",
          "models_pointer": "/data",
          "id_pointer": "/id"
        },
        "function_tools": {
          "strict": false,
          "tool_choice": "auto",
          "parallel_tool_calls": true
        },
        "native_tools": [],
        "native_tool_types": [],
        "native_tool_output_types": [],
        "response_item_types": [
          "message",
          "reasoning",
          "function_call"
        ],
        "response_content_types": [
          "output_text",
          "refusal",
          "encrypted_content"
        ],
        "replay": {
          "scope": "github-copilot-responses",
          "encrypted_reasoning": true,
          "encrypted_content": true,
          "assistant_messages": true,
          "native_tool_items": true,
          "foreign_encrypted": "reject",
          "strip_item_ids": [
            "message",
            "reasoning",
            "function_call"
          ]
        },
        "carrier_policy": {
          "max_inline_file_bytes": 20971520,
          "allowed_roles": [
            "user",
            "assistant",
            "system",
            "developer"
          ],
          "allowed_input_item_types": [
            "message"
          ],
          "allowed_content_types": [
            "input_text",
            "output_text",
            "input_file",
            "encrypted_content"
          ],
          "allowed_image_details": [
            "auto",
            "low",
            "high"
          ],
          "allowed_file_details": [
            "auto",
            "low",
            "high"
          ],
          "allowed_image_url_schemes": [
            "https",
            "data"
          ],
          "allowed_file_url_schemes": [
            "https"
          ],
          "rules": [
            {
              "label": "interface.input",
              "encoding": "json_text",
              "role": "user",
              "text_pointer": "/prompt"
            },
            {
              "label": "responses.input",
              "encoding": "responses_items",
              "items_pointer": "/items"
            }
          ]
        },
        "evidence_headers": [
          "copilot-user-quota-snapshot",
          "x-github-request-id",
          "x-request-id"
        ],
        "usage_required": true
      }
    },
    "transport": {
      "base_url": "https://api.githubcopilot.com",
      "wire": "github_copilot_responses",
      "auth_secret_ref": "secret://world_provider_github_copilot/COPILOT_API_TOKEN",
      "auth_header": "Authorization",
      "auth_value_prefix": "Bearer ",
      "headers": {
        "Copilot-Integration-Id": "vscode-chat",
        "Editor-Version": "vscode/1.104.1",
        "Openai-Intent": "conversation-edits",
        "User-Agent": "OctopusGitHubCopilot/0.1",
        "x-initiator": "agent"
      },
      "request_timeout_ms": 600000,
      "max_response_bytes": 134217728
    }
  }
}
