# Check text out with LF on every OS: registry descriptors, schemas, theme sources
# and notices are content-hashed, and CRLF checkouts (Windows core.autocrlf=true)
# would change those hashes.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.icns binary
*.mp4 binary
*.gif binary
*.woff2 binary
*.task binary
# Preserve original notice bytes used by provenance receipts.
**/licenses/** -text
