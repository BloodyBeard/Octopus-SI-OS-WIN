{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Movement",
  "type": "object",
  "required": [
    "from",
    "kind",
    "lamport",
    "recorded_at_unix_ms",
    "seq",
    "to",
    "trace"
  ],
  "properties": {
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/definitions/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "from": {
      "$ref": "#/definitions/Endpoint"
    },
    "invocation_metadata": {
      "anyOf": [
        {
          "$ref": "#/definitions/MovementMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "$ref": "#/definitions/MovementKind"
    },
    "lamport": {
      "$ref": "#/definitions/Lamport"
    },
    "recorded_at_unix_ms": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "seq": {
      "$ref": "#/definitions/Seq"
    },
    "to": {
      "$ref": "#/definitions/Endpoint"
    },
    "trace": {
      "type": "string"
    }
  },
  "definitions": {
    "ArtifactAccess": {
      "type": "object",
      "properties": {
        "change": {
          "default": false,
          "type": "boolean"
        },
        "create": {
          "default": false,
          "type": "boolean"
        },
        "delete": {
          "default": false,
          "type": "boolean"
        },
        "read": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "required": [
        "content",
        "id"
      ],
      "properties": {
        "content": {
          "$ref": "#/definitions/DescriptorHash"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "AttachedInterfaceBinding": {
      "type": "object",
      "required": [
        "direction",
        "interface",
        "interface_type",
        "role"
      ],
      "properties": {
        "direction": {
          "type": "string"
        },
        "interface": {
          "type": "string"
        },
        "interface_type": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AuthoredInterfaceBinding": {
      "type": "object",
      "required": [
        "config",
        "interface"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/InterfaceBindingConfig"
        },
        "interface": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "BindingArtifactPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "all"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "mode",
            "names",
            "namespaces"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "allow"
              ]
            },
            "names": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "CheckpointAdmissionMetadata": {
      "type": "object",
      "required": [
        "artifact_label",
        "complete"
      ],
      "properties": {
        "artifact_label": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "required_artifact_labels": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "CheckpointBindingPolicySnapshot": {
      "type": "object",
      "required": [
        "inbound"
      ],
      "properties": {
        "inbound": {
          "$ref": "#/definitions/AuthoredInterfaceBinding"
        },
        "outbound": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/AuthoredInterfaceBinding"
          }
        }
      },
      "additionalProperties": false
    },
    "DeliveryMetadata": {
      "type": "object",
      "required": [
        "delivery_verdict"
      ],
      "properties": {
        "delivery_verdict": {
          "$ref": "#/definitions/DeliveryVerdict"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/definitions/RuntimeInvocationMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_movement_seq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "DeliveryVerdict": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "admitted"
          ],
          "properties": {
            "admitted": {
              "type": "object",
              "required": [
                "seq"
              ],
              "properties": {
                "seq": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0.0
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "refused"
          ],
          "properties": {
            "refused": {
              "type": "object",
              "required": [
                "detail",
                "reason"
              ],
              "properties": {
                "detail": true,
                "reason": {
                  "$ref": "#/definitions/RefusedReason"
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "DescriptorHash": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "Endpoint": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "Interface"
          ],
          "properties": {
            "Interface": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "FormationPin": {
      "type": "object",
      "required": [
        "inputs"
      ],
      "properties": {
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/DescriptorHash"
          }
        }
      }
    },
    "GrantProjection": {
      "type": "object",
      "properties": {
        "artifact_access": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ArtifactAccess"
          }
        },
        "artifact_verbs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attached_interface_bindings": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttachedInterfaceBinding"
          }
        },
        "ee_root_slot_allowance": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "formation_pin": {
          "default": {
            "inputs": {}
          },
          "allOf": [
            {
              "$ref": "#/definitions/FormationPin"
            }
          ]
        },
        "goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "hard_blocked_tools": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interface_affordance_names": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interface_affordance_specs": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/InterfaceToolAffordance"
          }
        },
        "interface_policy": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "interfaces": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mark_outcomes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role_artifacts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "worker_environment_kinds": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "InterfaceBindingConfig": {
      "type": "object",
      "required": [
        "artifact_policy"
      ],
      "properties": {
        "artifact_policy": {
          "$ref": "#/definitions/BindingArtifactPolicy"
        }
      },
      "additionalProperties": false
    },
    "InterfaceToolAffordance": {
      "type": "object",
      "required": [
        "args_schema",
        "description",
        "name"
      ],
      "properties": {
        "args_schema": true,
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "InvocationMetadata": {
      "type": "object",
      "properties": {
        "artifact_binding_refs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ArtifactRef"
          }
        },
        "checkpoint_admission": {
          "anyOf": [
            {
              "$ref": "#/definitions/CheckpointAdmissionMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_binding_policy": {
          "anyOf": [
            {
              "$ref": "#/definitions/CheckpointBindingPolicySnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "grant": {
          "default": {
            "artifact_access": {},
            "artifact_verbs": [],
            "attached_interface_bindings": [],
            "formation_pin": {
              "inputs": {}
            },
            "hard_blocked_tools": [],
            "interface_affordance_names": [],
            "interface_affordance_specs": [],
            "interface_policy": {},
            "interfaces": [],
            "mark_outcomes": [],
            "role_artifacts": [],
            "tools": [],
            "worker_environment_kinds": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/GrantProjection"
            }
          ]
        },
        "outbound_interface_bindings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_verified_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequiredVerifiedArtifact"
          }
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/definitions/RuntimeInvocationMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_movement_seq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "verification_failure": {
          "anyOf": [
            {
              "$ref": "#/definitions/VerificationFailureMetadata"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Lamport": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "Mark": {
      "type": "object",
      "required": [
        "class",
        "name",
        "run",
        "run_epoch",
        "subject",
        "verifier"
      ],
      "properties": {
        "class": {
          "$ref": "#/definitions/MarkClass"
        },
        "details": {
          "default": null
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/definitions/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "run": {
          "type": "string"
        },
        "run_epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "subject": {
          "type": "string"
        },
        "verifier": {
          "type": "string"
        },
        "verifier_package": {
          "anyOf": [
            {
              "$ref": "#/definitions/VerifierPackagePin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "MarkClass": {
      "type": "string",
      "enum": [
        "success"
      ]
    },
    "MovementKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ArtifactMoved",
            "VerificationFailed",
            "DeliveryRefused",
            "InterfaceArrival",
            "InterfaceOutbound"
          ]
        },
        {
          "type": "object",
          "required": [
            "MarkOutcomeAdmitted"
          ],
          "properties": {
            "MarkOutcomeAdmitted": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "MovementMetadata": {
      "anyOf": [
        {
          "$ref": "#/definitions/DeliveryMetadata"
        },
        {
          "$ref": "#/definitions/Mark"
        },
        {
          "$ref": "#/definitions/InvocationMetadata"
        }
      ]
    },
    "RefusedReason": {
      "type": "string",
      "enum": [
        "no_binding",
        "policy",
        "verification_failed",
        "unknown_interface",
        "unknown_run",
        "stale_epoch",
        "checkpoint_spent",
        "settled",
        "malformed"
      ]
    },
    "RequiredVerifiedArtifact": {
      "type": "object",
      "required": [
        "artifact_label",
        "mark",
        "verifier"
      ],
      "properties": {
        "artifact_label": {
          "type": "string"
        },
        "mark": {
          "type": "string"
        },
        "params": {
          "default": null
        },
        "verifier": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "RuntimeInvocationMetadata": {
      "type": "object",
      "required": [
        "checkpoint",
        "ee",
        "epoch",
        "interface",
        "run",
        "worker"
      ],
      "properties": {
        "checkpoint": {
          "type": "string"
        },
        "ee": {
          "type": "string"
        },
        "epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "interface": {
          "type": "string"
        },
        "run": {
          "type": "string"
        },
        "run_record_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "worker": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Seq": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "VerificationFailureMetadata": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "artifact_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": true,
        "error": {
          "type": "string"
        },
        "mark": {
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifier_package": {
          "anyOf": [
            {
              "$ref": "#/definitions/VerifierPackagePin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "VerifierPackagePin": {
      "type": "object",
      "required": [
        "descriptor_content",
        "script_content"
      ],
      "properties": {
        "descriptor_content": {
          "$ref": "#/definitions/DescriptorHash"
        },
        "script_content": {
          "$ref": "#/definitions/DescriptorHash"
        }
      },
      "additionalProperties": false
    }
  }
}
