{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mark",
  "type": "object",
  "required": [
    "class",
    "name",
    "run",
    "run_epoch",
    "subject",
    "verifier"
  ],
  "properties": {
    "class": {
      "$ref": "#/definitions/MarkClass"
    },
    "details": {
      "default": null
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/definitions/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string"
    },
    "run": {
      "type": "string"
    },
    "run_epoch": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "subject": {
      "type": "string"
    },
    "verifier": {
      "type": "string"
    },
    "verifier_package": {
      "anyOf": [
        {
          "$ref": "#/definitions/VerifierPackagePin"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ArtifactRef": {
      "type": "object",
      "required": [
        "content",
        "id"
      ],
      "properties": {
        "content": {
          "$ref": "#/definitions/DescriptorHash"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "DescriptorHash": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "MarkClass": {
      "type": "string",
      "enum": [
        "success"
      ]
    },
    "VerifierPackagePin": {
      "type": "object",
      "required": [
        "descriptor_content",
        "script_content"
      ],
      "properties": {
        "descriptor_content": {
          "$ref": "#/definitions/DescriptorHash"
        },
        "script_content": {
          "$ref": "#/definitions/DescriptorHash"
        }
      },
      "additionalProperties": false
    }
  }
}
